      <Item class="ModuleScript" referent="RBXB6B3E201F58D4BDF">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Config.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Config")
-- PURE: no Roblox types, so the test suite can load it. Values marked PLACEHOLDER are starting guesses.

local Config = {}

Config.Version = "0.1.4"
Config.DefaultLanguage = "en"

-- Reach and placement (the server enforces these; the client uses the snap values for preview)
Config.MaxInteractDistance = 18        -- PLACEHOLDER studs. Raised from 14 to fit the workshop layout.
Config.InstallReachStuds = 3           -- PLACEHOLDER studs: proposed pose to socket
Config.SnapRadiusStuds = 2.5           -- PLACEHOLDER: preview magnet range
Config.SnapAngleDegrees = 15           -- PLACEHOLDER: allowed misalignment for snap and install
Config.BenchHalfExtents = { x = 20, y = 20, z = 20 }   -- PLACEHOLDER: parts stay inside this box around the origin
Config.WorkshopSpacing = 80            -- PLACEHOLDER studs between per-player workshops
Config.BinSpacing = 3                  -- used only by the legacy template path

-- Drag and pickup timing (client). PLACEHOLDER values.
Config.PlacementTimeoutSec = 3         -- how long a pending placement may wait for the server
Config.ConfirmDistanceStuds = 0.15     -- the real part counts as arrived within this distance
Config.DragThresholdPixels = 8         -- movement at or below this is a tap (select only)
Config.PickupTimeoutSec = 2            -- no pickup answer in time: the local drag is cancelled

-- Maximum requests per player per action per second (server)
Config.RateLimit = {
	PickUp = 5,
	ProposePlacement = 6,
	ReleaseHold = 10,
	RequestUninstall = 4,
	TightenScrew = 8,
	RequestBoot = 2,
}

Config.RemoteFolderName = "AssemblyRemotes"
Config.RemoteNames = {
	"PickUp",
	"ProposePlacement",
	"ReleaseHold",
	"RequestUninstall",
	"TightenScrew",
	"RequestBoot",
	"Feedback",
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX846B537C59B34DF1">
        <Properties>
          <string name="Name">Decisions</string>
          <ProtectedString name="Source">-- Decisions.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Decisions")
-- PURE. The one place where a placement is decided. The server uses it to decide, and the client uses it for the
-- green/red preview. Both pass the same inputs in the same order, so the preview cannot promise what the server refuses.

local AssemblyRules = require(script.Parent:WaitForChild("AssemblyRules"))
local PlacementRules = require(script.Parent:WaitForChild("PlacementRules"))

local Decisions = {}

-- Install into a socket. Order: rules, bench bounds, socket present, reach, alignment.
-- ctx: state, catalog, componentId, instanceId, slotId, proposed (pose), socket (pose or nil),
--      player (point or nil), benchOrigin, benchHalf, maxReach, cfg = { installReach, cosLimit }.
-- Returns ok, code, params.
function Decisions.install(ctx)
	local rulesOk, diag = AssemblyRules.validateInstall(ctx.state, ctx.catalog, ctx.componentId, ctx.instanceId, ctx.slotId)
	if not rulesOk then
		return false, diag.code, diag.params or {}
	end
	if not PlacementRules.inBounds(ctx.proposed.pos, ctx.benchOrigin, ctx.benchHalf) then
		return false, "OUT_OF_BOUNDS", {}
	end
	if ctx.socket == nil then
		return false, "NO_SOCKET", {}
	end
	if ctx.player == nil or not PlacementRules.inReach(ctx.player, ctx.socket.pos, ctx.maxReach) then
		return false, "TOO_FAR", {}
	end
	local poseOk, poseCode = PlacementRules.checkInstallPose(ctx.proposed, ctx.socket, ctx.cfg)
	if not poseOk then
		return false, poseCode, {}
	end
	return true, nil, {}
end

-- Free placement on the bench. Order: reach and bench bounds, then the layout rules (height, table, case, other parts).
-- ctx: player (point or nil), proposed (pose), benchOrigin, benchHalf, maxReach,
--      layout = nil (a part without a size, legacy) or { candidate, others, caseBox, surfaceY, tableBox }.
-- Returns ok, code, params.
function Decisions.free(ctx)
	if ctx.player == nil then
		return false, "TOO_FAR", {}
	end
	local poseOk, poseCode = PlacementRules.checkFreePose(ctx.proposed, ctx.player, ctx.benchOrigin, ctx.benchHalf, ctx.maxReach)
	if not poseOk then
		return false, poseCode, {}
	end
	local L = ctx.layout
	if L == nil then
		return true, nil, {}
	end
	local layoutOk, layoutCode, layoutParams = PlacementRules.checkFreeLayout(L.candidate, L.others, L.caseBox, L.surfaceY, L.tableBox)
	if not layoutOk then
		return false, layoutCode, layoutParams or {}
	end
	return true, nil, {}
end

return Decisions
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX36D5696632AE4FF7">
        <Properties>
          <string name="Name">DragSequence</string>
          <ProtectedString name="Source">-- DragSequence.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "DragSequence")
-- PURE state machine for ONE drag. It fixes the ORDER of requests so that:
--   * a drop is never sent before the server has acknowledged the pickup,
--   * a short movement is a TAP (select only). A tap never installs anything,
--   * exactly one terminal decision is made per drag,
--   * an answer for a different part is ignored.
-- It makes no network calls. The client executes the actions it returns.
-- Lua 5.1 subset: loads under standard Lua for tests.

local DragSequence = {}

-- Phases: "picking" (PickUp sent, no answer yet), "holding" (acknowledged),
--         "awaiting_eval" (the drop needs the client's geometry check), "done" (terminal).

function DragSequence.new(instanceId, thresholdPx)
	return { id = instanceId, threshold = thresholdPx, phase = "picking", dragged = false, released = false }
end

-- Distance is measured from the press point, in pixels. Movement after release does not count.
function DragSequence.pointerMoved(seq, distancePx)
	if seq.released or seq.phase == "done" then
		return
	end
	if distancePx &gt; seq.threshold then
		seq.dragged = true
	end
end

local function decide(seq)
	if not seq.dragged then
		seq.phase = "done"
		return { { type = "tap" } }
	end
	seq.phase = "awaiting_eval"
	return { { type = "evaluate" } }
end

-- The server's answer to the pickup. Answers for other parts are ignored.
function DragSequence.ack(seq, instanceId, ok)
	if seq.phase ~= "picking" or instanceId ~= seq.id then
		return {}
	end
	if not ok then
		seq.phase = "done"
		return { { type = "cancel" } }
	end
	seq.phase = "holding"
	if seq.released then
		return decide(seq)
	end
	return {}
end

-- Pointer released. Before the acknowledgement, the decision waits for it.
function DragSequence.release(seq)
	if seq.phase == "picking" then
		seq.released = true
		return {}
	end
	if seq.phase == "holding" then
		seq.released = true
		return decide(seq)
	end
	return {}
end

-- evaluation = { kind = "snap" | "free" | "invalid", slotId = ... } from the client's geometry check.
function DragSequence.resolve(seq, evaluation)
	if seq.phase ~= "awaiting_eval" then
		return {}
	end
	seq.phase = "done"
	if evaluation.kind == "snap" then
		return { { type = "propose", slotId = evaluation.slotId } }
	elseif evaluation.kind == "free" then
		return { { type = "propose", slotId = "" } }
	end
	return { { type = "release" } }
end

-- No pickup answer in time: release defensively. Any late answer is ignored from now on.
function DragSequence.timeout(seq)
	if seq.phase ~= "picking" then
		return {}
	end
	seq.phase = "done"
	return { { type = "release" } }
end

return DragSequence
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX029542257BE045D8">
        <Properties>
          <string name="Name">Ledger</string>
          <ProtectedString name="Source">-- Ledger.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Ledger")
-- PURE. Pays each order once. The wallet only grows through complete(), and complete() refuses repeats.
-- In V0.1 this lives in server memory only. Saving (DataStore) is deferred.

local Ledger = {}

function Ledger.new()
	return { balance = 0, completed = {} }
end

-- Returns true, "PAID" on the first valid completion.
-- Returns false, "ALREADY_PAID" for a repeat, and false, "INVALID" for a bad order id or payout.
function Ledger.complete(l, orderId, payout)
	if type(orderId) ~= "string" or orderId == "" then
		return false, "INVALID"
	end
	if type(payout) ~= "number" or payout ~= payout or payout &lt;= 0 or payout &gt; 1000000 or payout ~= math.floor(payout) then
		return false, "INVALID"
	end
	if l.completed[orderId] then
		return false, "ALREADY_PAID"
	end
	l.completed[orderId] = true
	l.balance = l.balance + payout
	return true, "PAID"
end

function Ledger.isComplete(l, orderId)
	return l.completed[orderId] == true
end

function Ledger.balanceOf(l)
	return l.balance
end

return Ledger
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXEE30214195234617">
        <Properties>
          <string name="Name">Locale</string>
          <ProtectedString name="Source">-- Locale.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Locale")
-- ALL translated text lives here. Codes, component ids, slot ids and protocol names never change with language.
-- PURE: no Roblox APIs. describe() takes the catalog as an argument.
-- Arabic text: Modern Standard Arabic. Brand names stay in Latin script. Arabic rendering is NOT TESTED IN ROBLOX STUDIO.

local Locale = {}

function Locale.isRtl(lang)
	return lang == "ar"
end

local UI = {
	en = {
		["ui.camera"] = "Camera",
		["ui.rotL"] = "Rotate -",
		["ui.rotR"] = "Rotate +",
		["ui.drop"] = "Drop",
		["ui.screw"] = "Screw",
		["ui.remove"] = "Remove",
		["ui.boot"] = "Boot",
		["ui.lang_to_ar"] = "عربي",
		["ui.lang_to_en"] = "English",
		["ui.start"] = "Tap a part to pick it up. Drag to move it, then release on a glowing socket to install.",
		["ui.selectFirst"] = "Tap a part first.",
		["ui.selectInstalled"] = "Tap an installed part first.",
		["ui.holdFirst"] = "Pick a part up first, then rotate it.",
		["ui.installedHint"] = "This part is installed. Use Screw or Remove.",
		["ui.more"] = "(+{n} more)",
		["ui.sent"] = "Sent. Waiting for the server...",
