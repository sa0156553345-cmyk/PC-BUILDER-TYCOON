      <Item class="ModuleScript" referent="RBXB6B3E201F58D4BDF">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Config.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Config")
-- PURE: no Roblox types, so the test suite can load it. Values marked PLACEHOLDER are starting guesses.

local Config = {}

Config.Version = "0.2.0"
Config.DefaultLanguage = "en"

-- Reach and placement (the server enforces these; the client uses the snap values for preview)
Config.MaxInteractDistance = 18        -- PLACEHOLDER studs.
Config.InstallReachStuds = 3           -- PLACEHOLDER studs: proposed pose to socket
Config.SnapRadiusStuds = 2.5           -- PLACEHOLDER: preview magnet range
Config.SnapAngleDegrees = 15           -- PLACEHOLDER: allowed misalignment for snap and install
Config.BenchHalfExtents = { x = 20, y = 20, z = 20 }   -- PLACEHOLDER: parts stay inside this box around the origin
Config.WorkshopSpacing = 80            -- PLACEHOLDER studs between per-player workshops

-- Drag and pickup timing (client). PLACEHOLDER values.
Config.PlacementTimeoutSec = 3
Config.ConfirmDistanceStuds = 0.15
Config.DragThresholdPixels = 8
Config.PickupTimeoutSec = 2

-- Economy (server). PLACEHOLDER amounts in game dollars.
Config.StartingCash = 200
Config.SellRatioPercent = 50           -- a loose part sells back for this share of its price

-- Maximum requests per player per action per second (server)
Config.RateLimit = {
	PickUp = 5,
	ProposePlacement = 6,
	ReleaseHold = 10,
	RequestUninstall = 4,
	TightenScrew = 8,
	RequestBoot = 2,
	BuyPart = 4,
	SellPart = 4,
	AcceptOrder = 2,
	DeliverOrder = 2,
}

Config.RemoteFolderName = "AssemblyRemotes"
Config.RemoteNames = {
	"PickUp", "ProposePlacement", "ReleaseHold", "RequestUninstall", "TightenScrew", "RequestBoot",
	"BuyPart", "SellPart", "AcceptOrder", "DeliverOrder",
	"Feedback",
}

return Config
</ProtectedString>
        </Properties>
