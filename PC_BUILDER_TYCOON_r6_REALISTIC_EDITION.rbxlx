        <Properties>
          <string name="Name">AssemblyRules</string>
          <ProtectedString name="Source">-- AssemblyRules.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "AssemblyRules")
-- PURE rule logic. No Roblox APIs. The SERVER runs these checks. Clients may run them for preview only.
-- Rules return codes and parameters, never display text. Text is produced by Locale.lua (language-specific).
-- validate* functions return true, or false plus { code = &lt;CODE_NAME&gt;, params = { ... } }.

local AssemblyRules = {}

local function fail(code, params)
	return false, { code = code, params = params or {} }
end

local function listContains(list, value)
	for _, item in ipairs(list) do
		if item == value then
			return true
		end
	end
	return false
end

-- state: { caseId, slots = {slotId -&gt; instanceId}, instances = {instanceId -&gt; {componentId, slotId}}, screws = {} }
function AssemblyRules.newState(caseId)
	return { caseId = caseId, slots = {}, instances = {}, screws = {} }
end

local function installedComponent(state, catalog, slotId)
	local instanceId = state.slots[slotId]
	if instanceId == nil then
		return nil
	end
	return catalog.Components[state.instances[instanceId].componentId]
end

-- Total capacity of the drives on the board (M.2 and SATA).
local function storageGB(state, catalog)
	local total = 0
	for _, slotId in ipairs({ "MB_M2", "MB_SATA" }) do
		local comp = installedComponent(state, catalog, slotId)
		if comp ~= nil then
			total = total + (comp.capacityGB or 0)
		end
	end
	return total
end

function AssemblyRules.validateInstall(state, catalog, componentId, instanceId, slotId)
	local comp = catalog.Components[componentId]
	if comp == nil then
		return fail("UNKNOWN_COMPONENT", { part = componentId })
	end
	local slot = catalog.Slots[slotId]
	if slot == nil then
		return fail("UNKNOWN_SLOT", { slot = slotId })
	end
	if state.instances[instanceId] ~= nil then
		return fail("ALREADY_INSTALLED", { part = componentId })
	end
	if state.slots[slotId] ~= nil then
		return fail("SLOT_OCCUPIED", { slot = slotId })
	end
	if not listContains(slot.accepts, comp.kind) then
		return fail("WRONG_PART_FOR_SLOT", { part = componentId, slot = slotId, kind = slot.accepts[1] })
	end
	if slot.iface ~= nil and comp.iface ~= slot.iface then
		return fail("STORAGE_WRONG_PORT", { part = componentId, slot = slotId, iface = slot.iface })
	end
	for _, requiredSlot in ipairs(slot.requires) do
		if state.slots[requiredSlot] == nil then
			return fail("PARENT_NOT_INSTALLED", { slot = requiredSlot })
		end
	end

	local caseComp = catalog.Components[state.caseId]
	if comp.kind == "Motherboard" and not listContains(caseComp.formFactors, comp.formFactor) then
		return fail("FORMFACTOR_MISMATCH", {
			part = componentId, formFactor = comp.formFactor, caseForm = table.concat(caseComp.formFactors, ", "),
		})
	end

	-- Safe: the requires lists above guarantee the motherboard exists for these checks.
	local board = installedComponent(state, catalog, "CASE_MB")
	if comp.kind == "CPU" and comp.socket ~= board.cpuSocket then
		return fail("SOCKET_MISMATCH", { part = componentId, socket = board.cpuSocket })
	end
	if comp.kind == "RAM" and comp.ramType ~= board.ramType then
		return fail("RAM_TYPE_MISMATCH", { part = componentId, ramType = board.ramType })
	end
	if comp.kind == "GPU" and comp.lengthMM &gt; caseComp.maxGpuMM then
		return fail("GPU_TOO_LONG", { part = componentId, maxMM = caseComp.maxGpuMM })
	end
	if comp.kind == "Cooler" then
		-- Safe: CPU_COOLER requires MB_CPU, so a CPU is installed.
		local cpu = installedComponent(state, catalog, "MB_CPU")
		if not listContains(comp.sockets, board.cpuSocket) then
			return fail("COOLER_SOCKET_MISMATCH", { part = componentId, socket = board.cpuSocket })
		end
		if comp.tdpRating &lt; cpu.tdp then
			return fail("COOLER_TDP_TOO_LOW", { part = componentId, tdp = cpu.tdp })
		end
		if comp.heightMM &gt; caseComp.maxCoolerMM then
			return fail("COOLER_TOO_TALL", { part = componentId, maxMM = caseComp.maxCoolerMM })
		end
	end
	if comp.kind == "Cable" then
		if slot.cableType ~= comp.cableType then
			return fail("CABLE_WRONG_PORT", { part = componentId, slot = slotId })
		end
		-- Safe: every cable slot requires CASE_PSU.
		local psu = installedComponent(state, catalog, "CASE_PSU")
		if not listContains(psu.cables, comp.cableType) then
			return fail("PSU_CABLE_UNAVAILABLE", { cableType = comp.cableType })
		end
	end
	return true
end

function AssemblyRules.applyInstall(state, componentId, instanceId, slotId)
	state.instances[instanceId] = { componentId = componentId, slotId = slotId }
	state.slots[slotId] = instanceId
	state.screws[instanceId] = 0
end

function AssemblyRules.validateUninstall(state, catalog, instanceId)
	local inst = state.instances[instanceId]
	if inst == nil then
		return fail("NOT_INSTALLED", {})
	end
	for otherSlot, otherInstanceId in pairs(state.slots) do
		for _, requiredSlot in ipairs(catalog.Slots[otherSlot].requires) do
			if requiredSlot == inst.slotId then
				local other = state.instances[otherInstanceId].componentId
				return fail("HAS_DEPENDENTS", { part = inst.componentId, other = other })
			end
		end
	end
	return true
end

-- V0.2 simplification: removing a part also removes its screws.
function AssemblyRules.applyUninstall(state, instanceId)
	local inst = state.instances[instanceId]
	state.slots[inst.slotId] = nil
	state.instances[instanceId] = nil
	state.screws[instanceId] = nil
end

function AssemblyRules.validateTighten(state, catalog, instanceId)
	local inst = state.instances[instanceId]
	if inst == nil then
		return fail("NOT_INSTALLED", {})
	end
	local comp = catalog.Components[inst.componentId]
	if (state.screws[instanceId] or 0) &gt;= (comp.screwsRequired or 0) then
		return fail("NO_SCREWS_NEEDED", { part = inst.componentId })
	end
	return true
end

function AssemblyRules.applyTighten(state, instanceId)
	state.screws[instanceId] = (state.screws[instanceId] or 0) + 1
end

function AssemblyRules.requiredWatts(state, catalog)
	local pm = catalog.PowerModel
	local total = pm.HeadroomWatts
	for _, inst in pairs(state.instances) do
		local comp = catalog.Components[inst.componentId]
		if comp.kind == "CPU" or comp.kind == "GPU" then
			total = total + (comp.tdp or 0)
		elseif comp.kind == "Motherboard" then
			total = total + pm.MotherboardWatts
		elseif comp.kind == "RAM" then
			total = total + pm.RamWattsPerStick
		elseif comp.kind == "Storage" then
			total = total + pm.StorageWatts
		elseif comp.kind == "Cooler" then
			total = total + pm.CoolerWatts
		end
	end
	return total
end

-- Boot test. Collects EVERY problem, so players see all of them at once.
function AssemblyRules.evaluateBoot(state, catalog)
	local diagnostics = {}
	local function add(code, params)
		table.insert(diagnostics, { code = code, params = params or {} })
	end

	local board = installedComponent(state, catalog, "CASE_MB")
	local psu = installedComponent(state, catalog, "CASE_PSU")
	if board == nil then
		add("NO_MOTHERBOARD")
	end
	if psu == nil then
		add("NO_PSU")
	end

	if board ~= nil then
		if state.slots["MB_CPU"] == nil then
			add("NO_CPU")
		elseif state.slots["CPU_COOLER"] == nil then
			add("NO_COOLER")
		end
		if state.slots["MB_RAM1"] == nil and state.slots["MB_RAM2"] == nil then
			add("NO_RAM")
		end
		if state.slots["MB_M2"] == nil and state.slots["MB_SATA"] == nil then
			add("NO_STORAGE")
		end
		for _, port in ipairs(board.requiredPorts) do
			if state.slots[port] == nil then
				add("MISSING_CABLE", { slot = port })
			end
		end
		if state.slots["MB_SATA"] ~= nil and state.slots["MB_SATA_CABLE"] == nil then
			add("MISSING_CABLE", { slot = "MB_SATA_CABLE" })
		end
	end
	if state.slots["MB_GPU"] ~= nil and state.slots["GPU_PWR8"] == nil then
		add("MISSING_CABLE", { slot = "GPU_PWR8" })
	end

	for instanceId, inst in pairs(state.instances) do
		local need = catalog.Components[inst.componentId].screwsRequired or 0
		local have = state.screws[instanceId] or 0
		if have &lt; need then
			add("SCREWS_INCOMPLETE", { part = inst.componentId, have = have, need = need })
		end
	end

	if board ~= nil and psu ~= nil then
		local needed = AssemblyRules.requiredWatts(state, catalog)
		if psu.watts &lt; needed then
			add("PSU_INSUFFICIENT", { needW = needed, watts = psu.watts })
		end
	end

	return { ok = (#diagnostics == 0), diagnostics = diagnostics }
end

-- Order check, the part of the delivery check that depends on the order. The PC must boot first.
function AssemblyRules.evaluateOrder(state, catalog, order)
	local boot = AssemblyRules.evaluateBoot(state, catalog)
	if not boot.ok then
		return false, boot.diagnostics
	end

	local ramGB = 0
	for _, slotId in ipairs({ "MB_RAM1", "MB_RAM2" }) do
		local comp = installedComponent(state, catalog, slotId)
		if comp ~= nil then
			ramGB = ramGB + (comp.capacityGB or 0)
		end
	end
	local storage = storageGB(state, catalog)

	local diagnostics = {}
	if ramGB &lt; order.minRamGB then
		table.insert(diagnostics, { code = "ORDER_RAM_TOO_LOW", params = { need = order.minRamGB, have = ramGB } })
	end
	if storage &lt; order.minStorageGB then
		table.insert(diagnostics, { code = "ORDER_STORAGE_TOO_SMALL", params = { need = order.minStorageGB, have = storage } })
	end
	return #diagnostics == 0, diagnostics
end

return AssemblyRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5EC76B9643784141">
        <Properties>
          <string name="Name">Catalog</string>
          <ProtectedString name="Source">-- Catalog.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Catalog")
-- Pure data. Product names are real and used only for identification. They imply no sponsorship or affiliation.
-- Game rules are SIMPLIFIED approximations. They are not vendor compatibility guarantees.
-- Every price, level and spec below is a PLACEHOLDER game value. Check real specs before any release.
-- Lua 5.1 subset: loads under standard Lua for tests.

local Catalog = {}

-- Install points. ownerSlot is the slot whose installed part carries this socket (nil = the case).
-- iface: a storage port only takes drives with that interface. cableType: a cable port only takes that cable.
Catalog.Slots = {
	CASE_MB  = { accepts = { "Motherboard" }, requires = {} },
	CASE_PSU = { accepts = { "PSU" }, requires = {} },
	MB_CPU   = { accepts = { "CPU" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB" },
	MB_RAM1  = { accepts = { "RAM" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB" },
	MB_RAM2  = { accepts = { "RAM" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB" },
	MB_M2    = { accepts = { "Storage" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB", iface = "NVME" },
	MB_SATA  = { accepts = { "Storage" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB", iface = "SATA" },
	MB_GPU   = { accepts = { "GPU" }, requires = { "CASE_MB" }, ownerSlot = "CASE_MB" },
	MB_PWR24 = { accepts = { "Cable" }, requires = { "CASE_MB", "CASE_PSU" }, ownerSlot = "CASE_MB", cableType = "MB24" },
	MB_CPU8  = { accepts = { "Cable" }, requires = { "CASE_MB", "CASE_PSU" }, ownerSlot = "CASE_MB", cableType = "CPU8" },
	MB_SATA_CABLE = { accepts = { "Cable" }, requires = { "MB_SATA", "CASE_PSU" }, ownerSlot = "CASE_MB", cableType = "SATA" },
	GPU_PWR8 = { accepts = { "Cable" }, requires = { "MB_GPU", "CASE_PSU" }, ownerSlot = "MB_GPU", cableType = "GPU8" },
	CPU_PASTE = { accepts = { "Paste" }, requires = { "MB_CPU" }, ownerSlot = "MB_CPU" },
	CPU_COOLER = { accepts = { "Cooler" }, requires = { "MB_CPU", "CPU_PASTE" }, ownerSlot = "MB_CPU" },
}

-- Game approximation for the boot power check. Not vendor guidance. Uses base TDP only.
Catalog.PowerModel = {
	HeadroomWatts = 50,
	MotherboardWatts = 40,
	RamWattsPerStick = 5,
	StorageWatts = 5,
	CoolerWatts = 5,
}

Catalog.Components = {
	case_corsair_4000d = {
		id = "case_corsair_4000d", name = "Corsair 4000D Airflow", kind = "Case",
		formFactors = { "ATX", "MATX", "ITX" }, maxGpuMM = 360, maxCoolerMM = 170, screwsRequired = 0,
	},
	psu_corsair_rm550 = {
		id = "psu_corsair_rm550", name = "Corsair RM550", kind = "PSU", price = 30, minLevel = 1,
		watts = 550, cables = { "MB24", "CPU8", "GPU8", "SATA" }, screwsRequired = 4,
	},
	mb_asus_b760m = {
		id = "mb_asus_b760m", name = "ASUS PRIME B760M-A WIFI D4", kind = "Motherboard", price = 35, minLevel = 1,
		formFactor = "MATX", cpuSocket = "LGA1700", ramType = "DDR4",
		requiredPorts = { "MB_PWR24", "MB_CPU8" }, screwsRequired = 6,
	},
	cpu_intel_i5_12400f = {
		id = "cpu_intel_i5_12400f", name = "Intel Core i5-12400F", kind = "CPU", price = 25, minLevel = 1,
		socket = "LGA1700", tdp = 65, screwsRequired = 0,
	},
	cpu_amd_ryzen5_5600 = {
		id = "cpu_amd_ryzen5_5600", name = "AMD Ryzen 5 5600", kind = "CPU", price = 20, minLevel = 1,
		socket = "AM4", tdp = 65, screwsRequired = 0,
	},
	ram_corsair_lpx_8_ddr4 = {
		id = "ram_corsair_lpx_8_ddr4", name = "Corsair Vengeance LPX 8GB DDR4-3200", kind = "RAM", price = 10, minLevel = 1,
		ramType = "DDR4", capacityGB = 8, screwsRequired = 0,
	},
	ram_corsair_vengeance_8_ddr5 = {
		id = "ram_corsair_vengeance_8_ddr5", name = "Corsair Vengeance 8GB DDR5-5200", kind = "RAM", price = 14, minLevel = 1,
		ramType = "DDR5", capacityGB = 8, screwsRequired = 0,
	},
	ssd_samsung_980_500 = {
		id = "ssd_samsung_980_500", name = "Samsung 980 500GB NVMe M.2", kind = "Storage", price = 15, minLevel = 1,
		iface = "NVME", capacityGB = 500, screwsRequired = 0,
	},
	hdd_seagate_1tb = {
		id = "hdd_seagate_1tb", name = "Seagate Barracuda 1TB 3.5-inch HDD", kind = "Storage", price = 20, minLevel = 1,
		iface = "SATA", capacityGB = 1000, screwsRequired = 0,
	},
	cable_rm550_mb24 = { id = "cable_rm550_mb24", name = "RM550 modular 24-pin cable", kind = "Cable", price = 2, minLevel = 1, cableType = "MB24", screwsRequired = 0 },
	cable_rm550_cpu8 = { id = "cable_rm550_cpu8", name = "RM550 modular 8-pin CPU cable", kind = "Cable", price = 2, minLevel = 1, cableType = "CPU8", screwsRequired = 0 },
	cable_rm550_gpu8 = { id = "cable_rm550_gpu8", name = "RM550 modular 8-pin GPU cable", kind = "Cable", price = 3, minLevel = 2, cableType = "GPU8", screwsRequired = 0 },
	cable_sata = { id = "cable_sata", name = "SATA data and power cable", kind = "Cable", price = 2, minLevel = 1, cableType = "SATA", screwsRequired = 0 },
	gpu_rtx_3060 = {
		id = "gpu_rtx_3060", name = "GeForce RTX 3060 12GB", kind = "GPU", price = 90, minLevel = 2,
		lengthMM = 242, tdp = 170, screwsRequired = 2,
	},
	cooler_tower_dual = {
		id = "cooler_tower_dual", name = "Dual-tower air CPU cooler", kind = "Cooler", price = 12, minLevel = 1,
		sockets = { "LGA1700", "AM4" }, tdpRating = 150, heightMM = 160, screwsRequired = 4,
	},
	paste_thermal = { id = "paste_thermal", name = "Thermal paste syringe", kind = "Paste", price = 2, minLevel = 1, screwsRequired = 0 },
}

-- The starter PC: the kit is free and placed on the bench at the start. "extras" are real but WRONG parts,
-- so players learn from mistakes.
Catalog.StarterPC = {
	caseId = "case_corsair_4000d",
	kit = {
		"psu_corsair_rm550", "mb_asus_b760m", "cpu_intel_i5_12400f", "paste_thermal", "cooler_tower_dual",
		"ram_corsair_lpx_8_ddr4", "ssd_samsung_980_500", "cable_rm550_mb24", "cable_rm550_cpu8",
	},
	extras = { "cpu_amd_ryzen5_5600", "ram_corsair_vengeance_8_ddr5" },
}

-- Customer orders. Payout and XP are granted on delivery, computed on the server. Amounts are PLACEHOLDERS.
Catalog.Orders = {
	office_01 = { id = "office_01", minRamGB = 8, minStorageGB = 250, payout = 250, xp = 60, minLevel = 1 },
	office_02 = { id = "office_02", minRamGB = 16, minStorageGB = 500, payout = 330, xp = 80, minLevel = 1 },
	gamer_01 = { id = "gamer_01", minRamGB = 16, minStorageGB = 500, needGpu = true, payout = 560, xp = 150, minLevel = 2 },
	designer_01 = { id = "designer_01", minRamGB = 16, minStorageGB = 1500, payout = 720, xp = 220, minLevel = 3 },
}

return Catalog
</ProtectedString>
        </Properties>
