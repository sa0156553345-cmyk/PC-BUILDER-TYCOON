  <Item class="ServerStorage" referent="RBX150ED4117E3E4DC7">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="RBXACFA68D274203FA81A7B3C75D554E221">
      <Properties>
        <string name="Name">Tests</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX98435CA6236F8B43FE18530CEE2EDDE8">
        <Properties>
          <string name="Name">test_catalog</string>
          <ProtectedString name="Source">-- Tests: the data hangs together. Every socket, cable, layout entry and product reference must exist.
return function(T, load)
	local Catalog = load("Catalog")
	local L = load("WorkshopLayout")

	local ownerSockets = { CASE_MB = L.BoardSockets, MB_CPU = L.CpuSockets, MB_GPU = L.GpuSockets }
	for slotId, slot in pairs(Catalog.Slots) do
		for _, req in ipairs(slot.requires) do
			T.check("slot " .. slotId .. " requires a defined slot", Catalog.Slots[req] ~= nil, req)
		end
		if slot.ownerSlot == nil then
			T.check("the case has a socket for " .. slotId, L.CaseSockets[slotId] ~= nil)
		else
			local sockets = ownerSockets[slot.ownerSlot]
			T.check("owner " .. slot.ownerSlot .. " has a socket for " .. slotId, sockets ~= nil and sockets[slotId] ~= nil)
		end
	end
	for name in pairs(L.BoardSockets) do T.check("board socket " .. name .. " is a slot", Catalog.Slots[name] ~= nil) end
	for name in pairs(L.CpuSockets) do T.check("CPU socket " .. name .. " is a slot", Catalog.Slots[name] ~= nil) end
	for name in pairs(L.GpuSockets) do T.check("GPU socket " .. name .. " is a slot", Catalog.Slots[name] ~= nil) end
	for name in pairs(L.CaseSockets) do T.check("case socket " .. name .. " is a slot", Catalog.Slots[name] ~= nil) end

	-- Every cable port has a PSU that supplies that cable.
	local psu = Catalog.Components.psu_corsair_rm550
	for slotId, slot in pairs(Catalog.Slots) do
		if slot.cableType ~= nil then
			local supplied = false
			for _, c in ipairs(psu.cables) do
				if c == slot.cableType then supplied = true end
			end
			T.check("the PSU supplies " .. slot.cableType .. " for " .. slotId, supplied)
		end
	end

	-- Every product kind can be installed somewhere, and every product has a layout entry.
	local kindsWithSlot = {}
	for _, slot in pairs(Catalog.Slots) do
		for _, kind in ipairs(slot.accepts) do kindsWithSlot[kind] = true end
	end
	for id, comp in pairs(Catalog.Components) do
		if comp.kind ~= "Case" then
			T.check(id .. " has a slot that accepts " .. comp.kind, kindsWithSlot[comp.kind] == true)
			T.check(id .. " has a layout entry", L.Components[id] ~= nil)
		end
	end
	for _, id in ipairs(Catalog.StarterPC.kit) do T.check("kit part " .. id .. " exists", Catalog.Components[id] ~= nil) end
	for _, id in ipairs(Catalog.StarterPC.extras) do T.check("extra part " .. id .. " exists", Catalog.Components[id] ~= nil) end

	-- Shop and orders.
	for id, comp in pairs(Catalog.Components) do
		if comp.price ~= nil then
			T.check(id .. " has a positive price", comp.price &gt; 0)
			T.check(id .. " has a level of at least 1", (comp.minLevel or 0) &gt;= 1)
		end
	end
	for id, order in pairs(Catalog.Orders) do
		T.check("order " .. id .. " pays and gives XP", order.payout &gt; 0 and order.xp &gt; 0)
		T.check("order " .. id .. " has a valid level", order.minLevel &gt;= 1 and order.minLevel &lt;= 6)
	end
	T.check("bench grid steps are positive", L.BinGrid.xStep &gt; 0 and L.BinGrid.zStep &gt; 0)
end
</ProtectedString>
        </Properties>
