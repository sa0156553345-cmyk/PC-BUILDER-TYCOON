      <Item class="ModuleScript" referent="RBXC85DC7E1D11F7504234253F9C06777BA">
        <Properties>
          <string name="Name">test_orders</string>
          <ProtectedString name="Source">-- Tests: Orders (grade, reward and status). The delivery check is covered in test_rules.
return function(T, load)
	local Orders = load("Orders")
	local Catalog = load("Catalog")

	T.eq("grade A with no mistakes", Orders.gradeFor(0), "A")
	T.eq("grade B with two mistakes", Orders.gradeFor(2), "B")
	T.eq("grade C with three mistakes", Orders.gradeFor(3), "C")

	local office = Catalog.Orders.office_01
	local a = Orders.reward(office, 0)
	T.eq("A pays the full payout", a.money, 250)
	T.eq("A gives the full XP", a.xp, 60)
	local b = Orders.reward(office, 1)
	T.eq("B pays 75 percent", b.money, 187)
	T.eq("B gives 75 percent of the XP", b.xp, 45)
	local c = Orders.reward(office, 9)
	T.eq("C pays half", c.money, 125)
	T.eq("C gives half the XP", c.xp, 30)
	T.eq("the grade is returned with the reward", c.grade, "C")

	local done = { office_01 = true }
	T.eq("a finished order shows completed", Orders.statusFor(office, 1, done, nil, false), "completed")
	T.eq("an active order that is not ready is in progress", Orders.statusFor(Catalog.Orders.office_02, 1, {}, "office_02", false), "in_progress")
	T.eq("an active order that passed the check is ready", Orders.statusFor(Catalog.Orders.office_02, 1, {}, "office_02", true), "ready")
	T.eq("a high-level order is locked at level 1", Orders.statusFor(Catalog.Orders.gamer_01, 1, {}, nil, false), "locked")
	T.eq("an unlocked order is new", Orders.statusFor(Catalog.Orders.gamer_01, 2, {}, nil, false), "new")
	T.eq("another active order leaves this one new", Orders.statusFor(office, 1, {}, "office_02", false), "new")
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX66CFA7FCBE4756742BE13BC6F290C773">
        <Properties>
          <string name="Name">test_progression</string>
          <ProtectedString name="Source">-- Tests: Progression (pure). Run by tests/run_all.lua and, inside Studio, by TestRunner.
return function(T, load)
	local P = load("Progression")
	T.eq("level 1 at 0 XP", P.levelFor(0), 1)
	T.eq("level 1 just below 150 XP", P.levelFor(149), 1)
	T.eq("level 2 at 150 XP", P.levelFor(150), 2)
	T.eq("level 3 at 400 XP", P.levelFor(400), 3)
	T.eq("level stays at the maximum", P.levelFor(99999), 6)
	T.check("no requirement means unlocked", P.isUnlocked(1, nil))
	T.check("locked below the required level", not P.isUnlocked(1, 2))
	T.check("unlocked at the required level", P.isUnlocked(2, 2))
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX50A5FD81715687BC8380585512464EAF">
        <Properties>
          <string name="Name">test_rules</string>
          <ProtectedString name="Source">-- Tests: AssemblyRules and the delivery check, using whole builds from the starter kit.
return function(T, load)
	local Rules = load("AssemblyRules")
	local Catalog = load("Catalog")
	local Orders = load("Orders")

	local function copyTable(t)
		local c = {}
		for k, v in pairs(t) do c[k] = v end
		return c
	end
	local function copyList(list)
		local out = {}
		for i, v in ipairs(list) do out[i] = v end
		return out
	end
	local function append(list, ...)
		local out = copyList(list)
		for _, entry in ipairs({ ... }) do table.insert(out, entry) end
		return out
	end
	-- A catalog with some component fields changed. overrides = { [componentId] = { field = value } }.
	local function variant(overrides)
		local cat = copyTable(Catalog)
		cat.Components = copyTable(Catalog.Components)
		for id, fields in pairs(overrides) do
			local comp = copyTable(Catalog.Components[id])
			for k, v in pairs(fields) do comp[k] = v end
			cat.Components[id] = comp
		end
		return cat
	end
	local function codesOf(list)
		local out = {}
		for _, d in ipairs(list or {}) do table.insert(out, d.code) end
		return table.concat(out, ",")
	end
	local function hasCode(list, code)
		for _, d in ipairs(list or {}) do
			if d.code == code then return true end
		end
		return false
	end
	-- Installs entries { componentId, slotId } in order. Returns the state and the first refusal, or nil.
	local function install(cat, list)
		local state = Rules.newState(cat.StarterPC.caseId)
		for _, entry in ipairs(list) do
			local id = entry[1] .. "#" .. entry[2]
			local ok, diag = Rules.validateInstall(state, cat, entry[1], id, entry[2])
			if not ok then return state, diag end
			Rules.applyInstall(state, entry[1], id, entry[2])
		end
		return state, nil
	end
	-- Installs and tightens every screw. Returns the state and the first refusal, or nil.
	local function build(cat, list)
		local state, diag = install(cat, list)
		if diag == nil then
			for id, inst in pairs(state.instances) do
				for _ = 1, (cat.Components[inst.componentId].screwsRequired or 0) do
					Rules.applyTighten(state, id)
				end
			end
		end
		return state, diag
	end

	local P = {
		psu = { "psu_corsair_rm550", "CASE_PSU" },
		mb = { "mb_asus_b760m", "CASE_MB" },
		cpu = { "cpu_intel_i5_12400f", "MB_CPU" },
		paste = { "paste_thermal", "CPU_PASTE" },
		cooler = { "cooler_tower_dual", "CPU_COOLER" },
		ram1 = { "ram_corsair_lpx_8_ddr4", "MB_RAM1" },
		ram2 = { "ram_corsair_lpx_8_ddr4", "MB_RAM2" },
		ssd = { "ssd_samsung_980_500", "MB_M2" },
		hdd = { "hdd_seagate_1tb", "MB_SATA" },
		sataCable = { "cable_sata", "MB_SATA_CABLE" },
		cable24 = { "cable_rm550_mb24", "MB_PWR24" },
		cable8 = { "cable_rm550_cpu8", "MB_CPU8" },
		gpu = { "gpu_rtx_3060", "MB_GPU" },
		gpuCable = { "cable_rm550_gpu8", "GPU_PWR8" },
	}
	local KIT = { P.psu, P.mb, P.cpu, P.paste, P.cooler, P.ram1, P.ssd, P.cable24, P.cable8 }
	local function kitWith(...) return append(KIT, ...) end

	-- The full starter build.
	local state, diag = build(Catalog, KIT)
	T.check("the starter kit installs in the 10-step order", diag == nil, diag and diag.code)
	local boot = Rules.evaluateBoot(state, Catalog)
	T.check("the starter kit boots", boot.ok, codesOf(boot.diagnostics))
	T.check("the starter kit meets office_01", (Orders.check(state, Catalog, Catalog.Orders.office_01)), codesOf(select(2, Orders.check(state, Catalog, Catalog.Orders.office_01))))
	T.eq("power need with cooler and CPU", Rules.requiredWatts(state, Catalog), 170)

	-- Refusals while installing.
	T.eq("cooler before paste is refused", select(2, build(Catalog, append({ P.psu, P.mb, P.cpu }, P.cooler))).code, "PARENT_NOT_INSTALLED")
	T.eq("paste before the CPU is refused", select(2, build(Catalog, append({ P.psu, P.mb }, P.paste))).code, "PARENT_NOT_INSTALLED")
	T.eq("wrong socket CPU is refused", select(2, build(Catalog, append({ P.psu, P.mb }, { "cpu_amd_ryzen5_5600", "MB_CPU" }))).code, "SOCKET_MISMATCH")
	T.eq("DDR5 memory on a DDR4 board is refused", select(2, build(Catalog, append({ P.psu, P.mb, P.cpu, P.paste, P.cooler }, { "ram_corsair_vengeance_8_ddr5", "MB_RAM1" }))).code, "RAM_TYPE_MISMATCH")
	T.eq("board too big for the case is refused", select(2, build(variant({ mb_asus_b760m = { formFactor = "EATX" } }), { P.psu, P.mb })).code, "FORMFACTOR_MISMATCH")
	T.eq("SATA drive in the M.2 slot is refused", select(2, build(Catalog, append({ P.psu, P.mb }, { "hdd_seagate_1tb", "MB_M2" }))).code, "STORAGE_WRONG_PORT")
	T.eq("M.2 drive in the SATA port is refused", select(2, build(Catalog, append({ P.psu, P.mb }, { "ssd_samsung_980_500", "MB_SATA" }))).code, "STORAGE_WRONG_PORT")
	T.eq("GPU longer than the case is refused", select(2, build(variant({ case_corsair_4000d = { maxGpuMM = 200 } }), append({ P.psu, P.mb }, P.gpu))).code, "GPU_TOO_LONG")
	T.eq("cooler taller than the case is refused", select(2, build(variant({ case_corsair_4000d = { maxCoolerMM = 100 } }), kitWith())).code, "COOLER_TOO_TALL")
	T.eq("cooler rated below the CPU is refused", select(2, build(variant({ cooler_tower_dual = { tdpRating = 40 } }), KIT)).code, "COOLER_TDP_TOO_LOW")
	T.eq("cooler for another socket is refused", select(2, build(variant({ cooler_tower_dual = { sockets = { "AM4" } } }), KIT)).code, "COOLER_SOCKET_MISMATCH")
	T.eq("GPU cable the PSU lacks is refused", select(2, build(variant({ psu_corsair_rm550 = { cables = { "MB24", "CPU8" } } }), append(KIT, P.gpu, P.gpuCable))).code, "PSU_CABLE_UNAVAILABLE")
	T.eq("a cable in the wrong port is refused", select(2, build(Catalog, append({ P.psu, P.mb }, { "cable_rm550_gpu8", "MB_PWR24" }))).code, "CABLE_WRONG_PORT")

	-- Boot test: every problem is listed.
	local noCooler = { P.psu, P.mb, P.cpu, P.ram1, P.ssd, P.cable24, P.cable8 }
	local s1 = build(Catalog, noCooler)
	T.check("no cooler stops the boot", hasCode(Rules.evaluateBoot(s1, Catalog).diagnostics, "NO_COOLER"))
	local noMb24 = { P.psu, P.mb, P.cpu, P.paste, P.cooler, P.ram1, P.ssd, P.cable8 }
	T.check("a missing 24-pin cable stops the boot", hasCode(Rules.evaluateBoot(build(Catalog, noMb24), Catalog).diagnostics, "MISSING_CABLE"))
	local weak = variant({ psu_corsair_rm550 = { watts = 150 } })
	T.check("a PSU below the need stops the boot", hasCode(Rules.evaluateBoot(build(weak, KIT), weak).diagnostics, "PSU_INSUFFICIENT"))
	local s2 = build(Catalog, kitWith(P.gpu))
	T.check("a GPU without its power cable stops the boot", hasCode(Rules.evaluateBoot(s2, Catalog).diagnostics, "MISSING_CABLE"))
	local s3 = build(Catalog, kitWith(P.hdd))
	T.check("a SATA drive without its cable stops the boot", hasCode(Rules.evaluateBoot(s3, Catalog).diagnostics, "MISSING_CABLE"))
	local s4 = install(Catalog, KIT)
	T.check("unscrewed parts stop the boot", hasCode(Rules.evaluateBoot(s4, Catalog).diagnostics, "SCREWS_INCOMPLETE"))
	T.check("GPU power need is added to the total", Rules.requiredWatts(build(Catalog, kitWith(P.gpu)), Catalog) == 340)

	-- Delivery check: each order's own requirement.
	local s5 = build(Catalog, kitWith(P.ram2))
	T.check("office_02 needs 16 GB and 500 GB", (Orders.check(s5, Catalog, Catalog.Orders.office_02)))
	local s6 = build(Catalog, kitWith(P.ram2, P.hdd, P.sataCable))
	T.check("designer_01 passes with both drives and 16 GB", (Orders.check(s6, Catalog, Catalog.Orders.designer_01)), codesOf(select(2, Orders.check(s6, Catalog, Catalog.Orders.designer_01))))
	local s7 = build(Catalog, KIT)
	T.check("designer_01 fails with 500 GB only", not Orders.check(s7, Catalog, Catalog.Orders.designer_01))
	T.check("gamer_01 fails without a GPU", hasCode(select(2, Orders.check(build(Catalog, kitWith(P.ram2)), Catalog, Catalog.Orders.gamer_01)), "ORDER_NEEDS_GPU"))
	local s8 = build(Catalog, kitWith(P.ram2, P.gpu, P.gpuCable))
	T.check("gamer_01 passes with GPU, power and 16 GB", (Orders.check(s8, Catalog, Catalog.Orders.gamer_01)), codesOf(select(2, Orders.check(s8, Catalog, Catalog.Orders.gamer_01))))

	-- Removing parts that others depend on.
	local s9 = build(Catalog, KIT)
	T.eq("CPU with paste on it cannot be removed", select(2, Rules.validateUninstall(s9, Catalog, "cpu_intel_i5_12400f#MB_CPU")).code, "HAS_DEPENDENTS")
	T.eq("PSU with cables cannot be removed", select(2, Rules.validateUninstall(s9, Catalog, "psu_corsair_rm550#CASE_PSU")).code, "HAS_DEPENDENTS")
	T.check("the cooler can be removed", Rules.validateUninstall(s9, Catalog, "cooler_tower_dual#CPU_COOLER"))
end
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
