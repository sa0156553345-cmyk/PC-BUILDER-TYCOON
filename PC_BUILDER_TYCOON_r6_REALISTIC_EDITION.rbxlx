      <Item class="ModuleScript" referent="RBXC6DCD561AB0C4AAC">
        <Properties>
          <string name="Name">PlacementRules</string>
          <ProtectedString name="Source">-- PlacementRules.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "PlacementRules")
-- PURE geometry on plain tables {x, y, z}. No Roblox APIs. Server authoritative; client uses it for preview only.
-- Poses are { pos = point, up = point, look = point }. point() reads .X/.Y/.Z, so Vector3 values work directly.

local PlacementRules = {}

function PlacementRules.point(v)
	return { x = v.X, y = v.Y, z = v.Z }
end

function PlacementRules.poseFromVectors(pos, up, look)
	return { pos = PlacementRules.point(pos), up = PlacementRules.point(up), look = PlacementRules.point(look) }
end

function PlacementRules.distance(a, b)
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function dot(a, b)
	return a.x * b.x + a.y * b.y + a.z * b.z
end

function PlacementRules.cosLimit(degrees)
	return math.cos(math.rad(degrees))
end

-- NaN fails every comparison, so NaN positions are rejected.
function PlacementRules.inBounds(pos, origin, half)
	return math.abs(pos.x - origin.x) &lt;= half.x
		and math.abs(pos.y - origin.y) &lt;= half.y
		and math.abs(pos.z - origin.z) &lt;= half.z
end

function PlacementRules.inReach(player, pos, maxDist)
	return PlacementRules.distance(player, pos) &lt;= maxDist
end

function PlacementRules.aligned(pose, target, cosLimit)
	return dot(pose.up, target.up) &gt;= cosLimit and dot(pose.look, target.look) &gt;= cosLimit
end

-- cfg = { installReach, cosLimit }. Returns true, or false plus a code.
function PlacementRules.checkInstallPose(pose, target, cfg)
	if not (PlacementRules.distance(pose.pos, target.pos) &lt;= cfg.installReach) then
		return false, "TOO_FAR"
	end
	if not PlacementRules.aligned(pose, target, cfg.cosLimit) then
		return false, "NOT_ALIGNED"
	end
	return true, nil
end

function PlacementRules.checkFreePose(pose, playerPos, origin, half, maxDist)
	if not PlacementRules.inBounds(pose.pos, origin, half) then
		return false, "OUT_OF_BOUNDS"
	end
	if not PlacementRules.inReach(playerPos, pose.pos, maxDist) then
		return false, "TOO_FAR"
	end
	return true, nil
end

-- candidates: list of { slotId, pose }. Returns the nearest one within radius, or nil.
function PlacementRules.nearest(candidates, pos, radius)
	local best, bestD = nil, radius
	for _, c in ipairs(candidates) do
		local d = PlacementRules.distance(pos, c.pose.pos)
		if d &lt;= bestD then
			best = c
			bestD = d
		end
	end
	return best
end

-- Snap target choice. candidates: list of { slotId, pose }, where pose is the socket pose. pos: the proposed point.
-- Each candidate within radius is tried from nearest to farthest with evaluate(candidate) -&gt; ok, code, params.
-- Returns the first candidate that passes, as candidate, true, nil, {}. When none passes, returns the nearest
-- in-range candidate with its refusal, as candidate, false, code, params. When nothing is in range, returns nil.
function PlacementRules.chooseSnap(candidates, pos, radius, evaluate)
	local inRange = {}
	for _, c in ipairs(candidates) do
		local d = PlacementRules.distance(pos, c.pose.pos)
		if d &lt;= radius then
			table.insert(inRange, { candidate = c, d = d })
		end
	end
	table.sort(inRange, function(a, b) return a.d &lt; b.d end)
	local firstRefusal = nil
	for _, entry in ipairs(inRange) do
		local ok, code, params = evaluate(entry.candidate)
		if ok then
			return entry.candidate, true, nil, {}
		end
		if firstRefusal == nil then
			firstRefusal = { candidate = entry.candidate, code = code, params = params or {} }
		end
	end
	if firstRefusal ~= nil then
		return firstRefusal.candidate, false, firstRefusal.code, firstRefusal.params
	end
	return nil, false, nil, {}
end

-- Converts a layout array {x, y, z} into a point {x = , y = , z = }.
function PlacementRules.fromArray(a)
	return { x = a[1], y = a[2], z = a[3] }
end

local function overlapAxis(a, b, sa, sb, margin)
	return math.abs(a - b) &lt; (sa + sb) / 2 - margin
end

-- Axis-aligned overlap in one shared space. Centres are points, sizes are arrays {x, y, z}.
-- margin lets touching boxes pass. NaN never overlaps, so callers check finiteness first.
function PlacementRules.boxesOverlap(centerA, sizeA, centerB, sizeB, margin)
	local m = margin or 0
	return overlapAxis(centerA.x, centerB.x, sizeA[1], sizeB[1], m)
		and overlapAxis(centerA.y, centerB.y, sizeA[2], sizeB[2], m)
		and overlapAxis(centerA.z, centerB.z, sizeA[3], sizeB[3], m)
end

-- True when the box bottom is at or above the surface, within tolerance.
function PlacementRules.bottomAbove(center, size, surfaceY, tolerance)
	return (center.y - size[2] / 2) &gt;= surfaceY - tolerance
end

-- True when the box lies fully on the table top in x and z. A part may touch the table edge, not overhang it.
-- Height is checked separately by bottomAbove.
function PlacementRules.insideFootprint(center, size, tableCenter, tableSize)
	local hx, hz = size[1] / 2, size[3] / 2
	local tx, tz = tableSize[1] / 2, tableSize[3] / 2
	return center.x - hx &gt;= tableCenter.x - tx
		and center.x + hx &lt;= tableCenter.x + tx
		and center.z - hz &gt;= tableCenter.z - tz
		and center.z + hz &lt;= tableCenter.z + tz
end

-- candidate and others: { id, componentId, center = point, size = array }.
-- caseBox: { center = point, size = array } or nil.
-- tableBox: { center = point, size = array } or nil. When given, the part must stay on the table top (OFF_TABLE).
-- Returns true, or false with a code and params.
function PlacementRules.checkFreeLayout(candidate, others, caseBox, surfaceY, tableBox)
	if not PlacementRules.bottomAbove(candidate.center, candidate.size, surfaceY, 0.6) then
		return false, "BELOW_TABLE", {}
	end
	if tableBox ~= nil and not PlacementRules.insideFootprint(candidate.center, candidate.size, tableBox.center, tableBox.size) then
		return false, "OFF_TABLE", {}
	end
	if caseBox ~= nil and PlacementRules.boxesOverlap(candidate.center, candidate.size, caseBox.center, caseBox.size, 0.05) then
		return false, "OVERLAPS_CASE", {}
	end
	for _, other in ipairs(others) do
		if PlacementRules.boxesOverlap(candidate.center, candidate.size, other.center, other.size, 0.05) then
			return false, "OVERLAPS_PART", { part = other.componentId }
		end
	end
	return true, nil, {}
end

return PlacementRules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXA523B8BBEB054924">
        <Properties>
          <string name="Name">PointerTracker</string>
          <ProtectedString name="Source">-- PointerTracker.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "PointerTracker")
-- PURE. Decides which pointer may drive a drag. Only one pointer is active at a time.
-- Touch: only the touch that started the drag can move or end it. Other fingers are ignored.
-- Mouse: any mouse movement moves the drag. Releasing the mouse button ends it.
-- A handle is an identity object. In Roblox it is the InputObject that began the press.

local PointerTracker = {}

function PointerTracker.new()
	return { active = nil }
end

-- Starts tracking. Returns false when another pointer is already active, or the kind is unknown.
function PointerTracker.begin(t, handle, kind)
	if t.active ~= nil then
		return false
	end
	if kind ~= "touch" and kind ~= "mouse" then
		return false
	end
	t.active = { handle = handle, kind = kind }
	return true
end

function PointerTracker.acceptsMove(t, handle, kind)
	local a = t.active
	if a == nil then
		return false
	end
	if a.kind == "mouse" then
		return kind == "mouse"
	end
	return kind == "touch" and handle ~= nil and handle == a.handle
end

function PointerTracker.acceptsEnd(t, handle, kind)
	local a = t.active
	if a == nil then
		return false
	end
	if a.kind == "mouse" then
		return kind == "mouse"
	end
	return kind == "touch" and handle ~= nil and handle == a.handle
end

function PointerTracker.finish(t)
	t.active = nil
end

function PointerTracker.isActive(t)
	return t.active ~= nil
end

return PointerTracker
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9A04E1441FED43A2">
        <Properties>
          <string name="Name">RateLimit</string>
          <ProtectedString name="Source">-- RateLimit.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "RateLimit")
-- PURE fixed-window limiter. The server creates one per player. Time is passed in, so it is testable.

local RateLimit = {}
RateLimit.__index = RateLimit

function RateLimit.new(limits)
	return setmetatable({ limits = limits, buckets = {} }, RateLimit)
end

-- Returns true if the action is allowed now. Unknown actions are always refused.
function RateLimit:allow(action, now)
	local limit = self.limits[action]
	if limit == nil then
		return false
	end
	local bucket = self.buckets[action]
	if bucket == nil or now - bucket.start &gt;= 1 then
		self.buckets[action] = { start = now, count = 1 }
		return true
	end
	if bucket.count &gt;= limit then
		return false
	end
	bucket.count = bucket.count + 1
	return true
end

return RateLimit
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5E96F29108F042B7">
        <Properties>
          <string name="Name">RemoteLayout</string>
          <ProtectedString name="Source">-- RemoteLayout.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "RemoteLayout")
-- PURE. Decides how the server must set up its RemoteEvent folder, given what already exists.
-- The server collects the top-level objects with the folder name and passes them in. Nothing is changed here.
-- Rule: when anything is ambiguous or wrong, STOP and report. Never guess, never silently replace existing objects.

local RemoteLayout = {}

local function findChildrenNamed(children, name)
	local found = {}
	for _, child in ipairs(children) do
		if child.name == name then
			table.insert(found, child)
		end
	end
	return found
end

-- folderName: expected folder name. required: RemoteEvent names. topLevel: { { name, className, children } }.
-- Returns { ok, action = "use_existing" | "create_folder" | "stop", create = { names }, issues = { { code, params } } }
function RemoteLayout.plan(folderName, required, topLevel)
	local matches = {}
	for _, obj in ipairs(topLevel) do
		if obj.name == folderName then
			table.insert(matches, obj)
		end
	end

	if #matches == 0 then
		local create = {}
		for _, name in ipairs(required) do
			table.insert(create, name)
		end
		return { ok = true, action = "create_folder", create = create, issues = {} }
	end

	-- The client resolves the folder by name. Two candidates would make the two sides disagree.
	if #matches &gt; 1 then
		return { ok = false, action = "stop", create = {}, issues = { { code = "DUPLICATE_FOLDER", params = { name = folderName, count = #matches } } } }
	end

	local folder = matches[1]
	if folder.className ~= "Folder" then
		return { ok = false, action = "stop", create = {}, issues = { { code = "NAME_TAKEN_BY_NON_FOLDER", params = { name = folderName, className = folder.className } } } }
	end

	local children = folder.children or {}
	local issues, create = {}, {}
	for _, name in ipairs(required) do
		local found = findChildrenNamed(children, name)
		if #found == 0 then
			table.insert(create, name)
		elseif #found &gt; 1 then
			table.insert(issues, { code = "DUPLICATE_REMOTE", params = { name = name, count = #found } })
		elseif found[1].className ~= "RemoteEvent" then
			table.insert(issues, { code = "WRONG_REMOTE_CLASS", params = { name = name, className = found[1].className } })
		end
	end

	if #issues &gt; 0 then
		return { ok = false, action = "stop", create = {}, issues = issues }
	end
	return { ok = true, action = "use_existing", create = create, issues = {} }
end

return RemoteLayout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX43BE5A7644394314">
        <Properties>
          <string name="Name">RequestGuard</string>
          <ProtectedString name="Source">-- RequestGuard.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "RequestGuard")
-- PURE checks for every argument a client can send. Malformed input is rejected before any state changes.
-- Points may be tables with x, y, z OR Vector3 values with X, Y, Z. Both are accepted.

local RequestGuard = {}

local MAX_ID_LENGTH = 64
local MAX_COORD = 1000000

function RequestGuard.isId(value)
	return type(value) == "string"
		and #value &gt;= 1
		and #value &lt;= MAX_ID_LENGTH
		and string.find(value, "^[%w_#]+$") ~= nil
end

-- Rejects NaN (n ~= n), infinities and absurdly large values.
function RequestGuard.isFiniteNumber(n)
	return type(n) == "number" and n == n and n &gt; -MAX_COORD and n &lt; MAX_COORD
end

function RequestGuard.isFinitePoint(p)
	if p == nil then
		return false
	end
	local ok, x, y, z = pcall(function()
		return p.X or p.x, p.Y or p.y, p.Z or p.z
	end)
	return ok and RequestGuard.isFiniteNumber(x) and RequestGuard.isFiniteNumber(y) and RequestGuard.isFiniteNumber(z)
end

function RequestGuard.isComponentId(value, catalog)
	return type(value) == "string" and catalog.Components[value] ~= nil
end

-- A slot id, or the empty string, which means free placement on the bench.
function RequestGuard.isSlotOrFree(value, catalog)
	if value == "" then
		return true
	end
	return type(value) == "string" and catalog.Slots[value] ~= nil
end

-- A pose is a position plus two direction vectors (pos, look, up). All three must be finite: a NaN orientation
-- reaches PivotTo just as a NaN position would. Points may be tables or Vector3 values.
function RequestGuard.isFinitePose(pose)
	if type(pose) ~= "table" then
		return false
	end
	return RequestGuard.isFinitePoint(pose.pos)
		and RequestGuard.isFinitePoint(pose.look)
		and RequestGuard.isFinitePoint(pose.up)
end

-- Every remote handler goes through here. The limiter runs first, so a malformed request also uses a token and
-- cannot flood the server with free replies. valid is the handler's own argument check.
-- Returns nil when the request may proceed, otherwise the code to reply with.
function RequestGuard.admit(limiter, action, now, valid)
	if not limiter:allow(action, now) then
		return "RATE_LIMITED"
	end
	if not valid then
		return "REQUEST_INVALID"
	end
	return nil
end

return RequestGuard
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXA00E435F5C054285">
        <Properties>
          <string name="Name">SessionHold</string>
          <ProtectedString name="Source">-- SessionHold.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "SessionHold")
-- PURE state for "which part this player is holding" on the server. One part at a time.
-- Rules that protect the player:
--   * pick replaces any earlier hold (the client never starts a second pick during a drag),
--   * release always takes effect, and is idempotent,
--   * every proposal ends the hold, whatever the outcome, so a rejected drop never leaves a part in hand.

local SessionHold = {}

function SessionHold.new()
	return { held = nil }
end

-- Returns the previously held id, or nil.
function SessionHold.pick(h, id)
	local previous = h.held
	h.held = id
	return previous
end

function SessionHold.heldId(h)
	return h.held
end

-- Clears the hold only if it is this part. Returns true when something was cleared.
function SessionHold.release(h, id)
	if id ~= nil and h.held == id then
		h.held = nil
		return true
	end
	return false
end

-- Called by every proposal. Returns true when the part was held (the proposal is for the held part).
function SessionHold.consume(h, id)
	local was = id ~= nil and h.held == id
	if was then
		h.held = nil
	end
	return was
end

return SessionHold
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0ED8F5D697594646">
        <Properties>
          <string name="Name">WorkshopLayout</string>
          <ProtectedString name="Source">-- WorkshopLayout.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "WorkshopLayout")
-- PURE DATA. Placeholder workshop geometry in studs. The origin is the workshop origin at ground level.
-- Points and sizes are arrays {x, y, z}. Sizes are full extents. Geometry is PLACEHOLDER (plain blocks).
-- Socket offsets: board sockets from the motherboard centre, CPU sockets from the CPU centre, GPU sockets from the GPU centre.
-- Lua 5.1 subset.

local L = {}

L.TableTopY = 3
L.Floor = { center = { 0, -0.5, 0 }, size = { 80, 1, 80 } }
L.Table = { center = { 0, 1.5, -1.5 }, size = { 44, 3, 13 } }

-- The case is open at the front and top. Its base rests on the table.
L.Case = { center = { 0, 9, -1.5 }, size = { 12, 12, 9 } }
L.CaseWalls = {
	{ center = { 0, 3.2, -1.5 }, size = { 12, 0.4, 9 } },
	{ center = { -5.8, 9, -1.5 }, size = { 0.4, 12, 9 } },
	{ center = { 5.8, 9, -1.5 }, size = { 0.4, 12, 9 } },
	{ center = { 0, 9, -5.8 }, size = { 12, 12, 0.4 } },
}

-- Case install points, absolute workshop coordinates.
L.CaseSockets = {
	CASE_MB = { 0, 9, -5.0 },
	CASE_PSU = { 0, 4.65, -4.0 },
}

-- Board install points, offsets from the motherboard centre (board-local).
L.BoardSockets = {
	MB_CPU = { -1.5, 2.8, 0.4 },
	MB_RAM1 = { 2.0, 2.0, 0.45 },
	MB_RAM2 = { 2.7, 2.0, 0.45 },
	MB_M2 = { -2.8, -2.5, 0.35 },
	MB_SATA = { -3.8, -4.2, 0.7 },
	MB_SATA_CABLE = { -0.6, -4.2, 0.35 },
	MB_GPU = { 0.5, -2.8, 1.6 },
	MB_PWR24 = { 3.8, 3.5, 0.35 },
	MB_CPU8 = { 3.8, 1.0, 0.35 },
}

-- CPU install points, offsets from the CPU centre. The paste sits on the die, the cooler sits on the paste.
L.CpuSockets = {
	CPU_PASTE = { 0, 0, 0.4 },
	CPU_COOLER = { 0, 0, 1.35 },
}

-- GPU install points, offsets from the GPU centre.
L.GpuSockets = {
	GPU_PWR8 = { 3.8, 1.2, 0 },
}

L.Light = { center = { 6.3, 13, 2.5 }, size = { 0.6, 0.6, 0.3 } }

-- The player stands here and faces the bench. Every interaction point must be in reach from here.
L.StandPoint = { 0, 3, 7 }
L.BenchFocus = { 0, 6, -1.5 }

-- Where parts are looked for on the table: a grid of {x, z} candidates in workshop coordinates.
-- BinPlanner tries z first, then x, and keeps the first spot that overlaps nothing.
L.BinGrid = { xMin = -20, xMax = 20, xStep = 1.5, zMin = -7, zMax = 4, zStep = 1 }

-- Placeholder geometry per product: size, colour (RGB 0..1) and a short label. Shapes are blocks for now.
L.Components = {
	case_corsair_4000d = { kind = "Case", size = { 12, 12, 9 }, color = { 0.12, 0.12, 0.14 }, label = "4000D" },
	psu_corsair_rm550 = { kind = "PSU", size = { 4, 2.5, 3 }, color = { 0.10, 0.10, 0.12 }, label = "RM550" },
	mb_asus_b760m = { kind = "Motherboard", size = { 10, 10, 0.4 }, color = { 0.10, 0.30, 0.20 }, label = "B760M" },
	cpu_intel_i5_12400f = { kind = "CPU", size = { 2.2, 2.2, 0.4 }, color = { 0.70, 0.72, 0.78 }, label = "i5-12400F" },
	cpu_amd_ryzen5_5600 = { kind = "CPU", size = { 2.2, 2.2, 0.4 }, color = { 0.70, 0.72, 0.78 }, label = "R5 5600" },
	ram_corsair_lpx_8_ddr4 = { kind = "RAM", size = { 0.5, 3, 0.5 }, color = { 0.20, 0.45, 0.85 }, label = "8GB DDR4" },
	ram_corsair_vengeance_8_ddr5 = { kind = "RAM", size = { 0.5, 3, 0.5 }, color = { 0.20, 0.45, 0.85 }, label = "8GB DDR5" },
	ssd_samsung_980_500 = { kind = "Storage", size = { 2.8, 0.9, 0.3 }, color = { 0.18, 0.18, 0.20 }, label = "980 500GB" },
	hdd_seagate_1tb = { kind = "Storage", size = { 3.8, 1.0, 1.0 }, color = { 0.60, 0.62, 0.66 }, label = "HDD 1TB" },
	cable_rm550_mb24 = { kind = "Cable", size = { 0.5, 1.6, 0.3 }, color = { 0.92, 0.92, 0.92 }, label = "24-pin" },
	cable_rm550_cpu8 = { kind = "Cable", size = { 0.5, 1.6, 0.3 }, color = { 0.92, 0.92, 0.92 }, label = "8-pin CPU" },
	cable_rm550_gpu8 = { kind = "Cable", size = { 0.5, 1.6, 0.3 }, color = { 0.10, 0.10, 0.10 }, label = "8-pin GPU" },
	cable_sata = { kind = "Cable", size = { 0.5, 1.6, 0.3 }, color = { 0.80, 0.15, 0.15 }, label = "SATA" },
	gpu_rtx_3060 = { kind = "GPU", size = { 9, 4.4, 2.2 }, color = { 0.08, 0.08, 0.10 }, label = "RTX 3060" },
	cooler_tower_dual = { kind = "Cooler", size = { 3.2, 3.2, 1.6 }, color = { 0.75, 0.78, 0.82 }, label = "Cooler" },
	paste_thermal = { kind = "Paste", size = { 0.8, 0.9, 0.25 }, color = { 0.20, 0.80, 0.80 }, label = "Paste" },
}

return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX46EFE8BDCE37CD985192DB7D5C0C82FB">
        <Properties>
          <string name="Name">BinPlanner</string>
          <ProtectedString name="Source">-- BinPlanner.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "BinPlanner")
-- PURE. Finds a free spot on the bench table for a part that is bought or returned. It uses the same layout rules
-- as free placement, so a spot it returns is always a spot the server would accept.

local PlacementRules = require(script.Parent:WaitForChild("PlacementRules"))

local BinPlanner = {}

-- size: {x, y, z}. others: loose parts as { center = point, size = array }.
-- caseBox and tableBox: as in PlacementRules.checkFreeLayout. grid: { xMin, xMax, xStep, zMin, zMax, zStep }.
-- Returns x, z in workshop coordinates, or nil when nothing fits. Scans z first, then x, so the result is deterministic.
function BinPlanner.findSpot(size, others, caseBox, tableBox, surfaceY, grid)
	local cy = surfaceY + size[2] / 2
	for z = grid.zMin, grid.zMax, grid.zStep do
		for x = grid.xMin, grid.xMax, grid.xStep do
			local candidate = { id = "candidate", componentId = "", center = { x = x, y = cy, z = z }, size = size }
			if PlacementRules.checkFreeLayout(candidate, others, caseBox, surfaceY, tableBox) then
				return x, z
			end
		end
	end
	return nil
end

return BinPlanner
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXF36C55052D6C1B97D5186D2C25EC098B">
        <Properties>
          <string name="Name">Orders</string>
          <ProtectedString name="Source">-- Orders.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Orders")
-- PURE. Order status, the delivery check, and the reward. The server decides; the client only shows the status.
-- Grade comes from the wrong-part refusals counted since the last delivery. Reward and XP scale with the grade.

local AssemblyRules = require(script.Parent:WaitForChild("AssemblyRules"))
local Progression = require(script.Parent:WaitForChild("Progression"))

local Orders = {}

Orders.GradePercent = { A = 100, B = 75, C = 50 }   -- PLACEHOLDER reward shares

function Orders.gradeFor(mistakes)
	if mistakes &lt;= 0 then
		return "A"
	end
	if mistakes &lt;= 2 then
		return "B"
	end
	return "C"
end

-- Returns { grade, money, xp } for a delivered order.
function Orders.reward(order, mistakes)
	local grade = Orders.gradeFor(mistakes)
	local pct = Orders.GradePercent[grade]
	return { grade = grade, money = math.floor(order.payout * pct / 100), xp = math.floor(order.xp * pct / 100) }
end

-- The delivery check. Boot first (AssemblyRules), then RAM and storage, then the parts the order names.
-- Returns true, or false plus diagnostics { code, params }.
function Orders.check(state, catalog, order)
	local _, diagnostics = AssemblyRules.evaluateOrder(state, catalog, order)
	diagnostics = diagnostics or {}
	if order.needGpu and state.slots["MB_GPU"] == nil then
		table.insert(diagnostics, { code = "ORDER_NEEDS_GPU", params = {} })
	end
	return #diagnostics == 0, diagnostics
end

-- Status as the player sees it: "locked", "new", "in_progress", "ready" or "completed".
-- completed: set of finished order ids. activeId: the order in progress, or nil. ready: the last check passed.
function Orders.statusFor(order, level, completed, activeId, ready)
	if completed[order.id] then
		return "completed"
	end
	if activeId == order.id then
		if ready then
			return "ready"
		end
		return "in_progress"
	end
	if not Progression.isUnlocked(level, order.minLevel) then
		return "locked"
	end
	return "new"
end

return Orders
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7EC69493E5FB3DC2D78C26A7487183C2">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source">-- Progression.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Progression")
-- PURE. Turns XP into a level. Products and orders name the level they need.
-- PLACEHOLDER thresholds: XP needed to reach level 1..6 (the index is the level).

local Progression = {}

Progression.Thresholds = { 0, 150, 400, 800, 1400, 2200 }

function Progression.levelFor(xp)
	local level = 1
	for i, need in ipairs(Progression.Thresholds) do
		if xp &gt;= need then
			level = i
		end
	end
	return level
end

function Progression.isUnlocked(level, minLevel)
	return level &gt;= (minLevel or 1)
end

return Progression
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16B4C1C8DE9299CAAB30B26A194C4F54">
        <Properties>
          <string name="Name">Store</string>
          <ProtectedString name="Source">-- Store.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Store")
-- PURE rules for buying and selling parts. The server decides; the client uses the same rules to show prices.

local Progression = require(script.Parent:WaitForChild("Progression"))

local Store = {}

-- Returns true, or false plus a code.
function Store.canBuy(balance, level, comp)
	if comp == nil or comp.price == nil then
		return false, "UNKNOWN_COMPONENT"
	end
	if not Progression.isUnlocked(level, comp.minLevel) then
		return false, "PRODUCT_LOCKED"
	end
	if balance &lt; comp.price then
		return false, "NOT_ENOUGH_CASH"
	end
	return true, nil
end

function Store.sellValue(price, ratioPercent)
	return math.floor(price * ratioPercent / 100)
end

-- Products for the shop list, cheapest first, then by id, so the order never changes between sessions.
-- Each entry: { id, name, kind, price, minLevel, unlocked }. Products without a price (the case) are not sold.
function Store.listFor(catalog, level)
	local list = {}
	for id, comp in pairs(catalog.Components) do
		if comp.price ~= nil then
			table.insert(list, {
				id = id, name = comp.name, kind = comp.kind, price = comp.price,
				minLevel = comp.minLevel or 1, unlocked = Progression.isUnlocked(level, comp.minLevel),
			})
		end
	end
	table.sort(list, function(a, b)
		if a.price ~= b.price then
			return a.price &lt; b.price
		end
		return a.id &lt; b.id
	end)
	return list
end

return Store
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX60E0B6F3D3A84039">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBXPCBUILDER_SAFESPAWN_R5">
      <Properties>
        <string name="Name">PCBuilderSafeSpawn</string>
        <ProtectedString name="Source">-- PCBuilderSafeSpawn.server.lua
-- Fallback spawn area for the prototype. The workshop system moves players to their
-- own workshop after it has been created. This pad keeps the initial spawn safe if
-- the workshop setup fails or takes longer than expected.
local Workspace = game:GetService("Workspace")

local PAD_NAME = "PCBuilderSafeSpawnPad"
local SPAWN_NAME = "PCBuilderSafeSpawnLocation"

local pad = Workspace:FindFirstChild(PAD_NAME)
if pad == nil then
	pad = Instance.new("Part")
	pad.Name = PAD_NAME
	pad.Size = Vector3.new(40, 1, 40)
	pad.CFrame = CFrame.new(0, -0.5, 0)
	pad.Anchored = true
	pad.CanCollide = true
	pad.CanTouch = true
	pad.Material = Enum.Material.Concrete
	pad.Color = Color3.fromRGB(66, 68, 76)
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.BottomSurface = Enum.SurfaceType.Smooth
	pad.Parent = Workspace
end

local spawn = Workspace:FindFirstChild(SPAWN_NAME)
if spawn == nil then
	spawn = Instance.new("SpawnLocation")
	spawn.Name = SPAWN_NAME
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.Parent = Workspace
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBXBFF50400A6DA4F68">
      <Properties>
        <string name="Name">AssemblyServer</string>
        <ProtectedString name="Source">-- AssemblyServer.server.lua
-- Place in: ServerScriptService (Script named "AssemblyServer")
-- ROLE: the authoritative workshop. Validates every request, enforces ownership, places parts, runs the boot and
--       delivery checks, sells and buys parts, accepts orders, and pays each delivery once.
--       Clients send requests only. Replies carry codes and params, never display text.
-- STATUS: NOT YET RUN INSIDE ROBLOX STUDIO.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local AssemblyRules = require(Shared:WaitForChild("AssemblyRules"))
local PlacementRules = require(Shared:WaitForChild("PlacementRules"))
local RateLimit = require(Shared:WaitForChild("RateLimit"))
local RemoteLayout = require(Shared:WaitForChild("RemoteLayout"))
local RequestGuard = require(Shared:WaitForChild("RequestGuard"))
local SessionHold = require(Shared:WaitForChild("SessionHold"))
local Ledger = require(Shared:WaitForChild("Ledger"))
local WorkshopLayout = require(Shared:WaitForChild("WorkshopLayout"))
local Decisions = require(Shared:WaitForChild("Decisions"))
local Progression = require(Shared:WaitForChild("Progression"))
local Orders = require(Shared:WaitForChild("Orders"))
local Store = require(Shared:WaitForChild("Store"))
local BinPlanner = require(Shared:WaitForChild("BinPlanner"))
local WorkshopBuilder = require(script.Parent:WaitForChild("WorkshopBuilder"))

local INSTALL_CFG = {
	installReach = Config.InstallReachStuds,
	cosLimit = PlacementRules.cosLimit(Config.SnapAngleDegrees),
}
local BENCH_HALF = Config.BenchHalfExtents
local TABLE_TOP = WorkshopLayout.TableTopY
local CASE_BOX = { center = PlacementRules.fromArray(WorkshopLayout.Case.center), size = WorkshopLayout.Case.size }
local TABLE_BOX = { center = PlacementRules.fromArray(WorkshopLayout.Table.center), size = WorkshopLayout.Table.size }
local BOOT_COLORS = {
	idle = Color3.fromRGB(120, 120, 120),
	ok = Color3.fromRGB(60, 220, 110),
	fail = Color3.fromRGB(230, 70, 70),
}

-- Refusals that count as a wrong part. Each one adds a mistake, which lowers the grade of the next delivery.
local MISTAKE_CODES = {
	WRONG_PART_FOR_SLOT = true, FORMFACTOR_MISMATCH = true, SOCKET_MISMATCH = true, RAM_TYPE_MISMATCH = true,
	CABLE_WRONG_PORT = true, PSU_CABLE_UNAVAILABLE = true, STORAGE_WRONG_PORT = true, GPU_TOO_LONG = true,
	COOLER_SOCKET_MISMATCH = true, COOLER_TDP_TOO_LOW = true, COOLER_TOO_TALL = true,
}

local workshopsFolder = Workspace:FindFirstChild("Workshops")
if workshopsFolder == nil then
	workshopsFolder = Instance.new("Folder")
	workshopsFolder.Name = "Workshops"
	workshopsFolder.Parent = Workspace
end

-- Remote setup. Deterministic: reuse one valid folder, create only what is missing, STOP on any conflict.
local function describeIssue(issue)
	local p = issue.params
	if issue.code == "DUPLICATE_FOLDER" then
		return "Found " .. p.count .. " objects named '" .. p.name .. "' directly under ReplicatedStorage. Keep exactly one Folder with that name."
	elseif issue.code == "NAME_TAKEN_BY_NON_FOLDER" then
		return "'" .. p.name .. "' under ReplicatedStorage is a " .. p.className .. ", not a Folder. Rename or remove it."
	elseif issue.code == "DUPLICATE_REMOTE" then
		return "'" .. p.name .. "' appears " .. p.count .. " times inside the Folder. Keep exactly one RemoteEvent with that name."
	elseif issue.code == "WRONG_REMOTE_CLASS" then
		return "'" .. p.name .. "' inside the Folder is a " .. p.className .. ", but it must be a RemoteEvent."
	end
	return "Unknown remote setup issue: " .. tostring(issue.code)
end

local function collectTopLevel(folderName)
	local list = {}
	for _, child in ipairs(ReplicatedStorage:GetChildren()) do
		if child.Name == folderName then
			local entry = { name = child.Name, className = child.ClassName, children = {} }
			for _, grandchild in ipairs(child:GetChildren()) do
				table.insert(entry.children, { name = grandchild.Name, className = grandchild.ClassName })
			end
			table.insert(list, entry)
		end
	end
	return list
end

local remoteFolder = nil
local layout = RemoteLayout.plan(Config.RemoteFolderName, Config.RemoteNames, collectTopLevel(Config.RemoteFolderName))
for _, issue in ipairs(layout.issues) do
	warn("[AssemblyServer] Remote setup conflict: " .. describeIssue(issue))
end
if layout.action == "stop" then
	warn("[AssemblyServer] Remote setup STOPPED. Nothing was created or changed in ReplicatedStorage. Fix the conflict above, then press Play again.")
else
	if layout.action == "create_folder" then
		local created = Instance.new("Folder")
		created.Name = Config.RemoteFolderName
		created.Parent = ReplicatedStorage
	end
	local folder = ReplicatedStorage:FindFirstChild(Config.RemoteFolderName)
	for _, name in ipairs(layout.create) do
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = folder
	end
	local verified = folder ~= nil
	for _, name in ipairs(Config.RemoteNames) do
		local event = folder and folder:FindFirstChild(name)
		if event == nil or not event:IsA("RemoteEvent") then
			verified = false
			warn("[AssemblyServer] Could not verify RemoteEvent '" .. name .. "' after setup.")
		end
	end
	if verified then
		remoteFolder = folder
	else
		warn("[AssemblyServer] Remote setup did not verify. Workshops stay disabled until this is fixed.")
	end
end

local sessions = {}
local workshopCount = 0

-- kind: "system", "pickup", "placement", "uninstall", "screw", "boot", "shop" or "order"
local function notify(player, kind, ok, code, params, extra)
	if remoteFolder == nil then
		return
	end
	extra = extra or {}
	remoteFolder.Feedback:FireClient(player, {
		kind = kind,
		ok = ok,
		code = code,
		params = params or {},
		instanceId = extra.instanceId,
		diagnostics = extra.diagnostics or {},
		final = extra.final,
	})
end

local function notifyInvalid(player, kind, instanceId)
	notify(player, kind, false, "REQUEST_INVALID", {}, { instanceId = RequestGuard.isId(instanceId) and instanceId or nil })
end

local function rootPoint(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root == nil then
		return nil
	end
	return PlacementRules.point(root.Position)
end

local function poseOf(cf)
	return PlacementRules.poseFromVectors(cf.Position, cf.UpVector, cf.LookVector)
end

local function setAnchored(model, anchored)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = anchored
		end
	end
end

-- Socket parts live on the case, or on the installed owner part (board sockets on the motherboard, CPU sockets on the CPU).
local function findSocket(session, slotId)
	local slot = Catalog.Slots[slotId]
	if slot == nil then
		return nil
	end
	local owner
	if slot.ownerSlot == nil then
		owner = session.workshop:FindFirstChild("Case")
	else
		local ownerInstance = session.state.slots[slot.ownerSlot]
		owner = ownerInstance and session.parts[ownerInstance]
	end
	if owner == nil then
		return nil
	end
	local socket = owner:FindFirstChild(slotId, true)
	if socket and socket:IsA("BasePart") then
		return socket
	end
	return nil
end

local function hostOf(model)
	return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end

-- Screw progress shown above an installed part that needs screws.
local function setScrewLabel(model, have, need)
	local host = hostOf(model)
	if host == nil or need &lt;= 0 then
		return
	end
	local gui = host:FindFirstChild("ScrewLabel")
	if gui == nil then
		gui = Instance.new("BillboardGui")
		gui.Name = "ScrewLabel"
		gui.Size = UDim2.fromOffset(60, 18)
		gui.StudsOffset = Vector3.new(0, host.Size.Y / 2 + 3.4, 0)
		gui.MaxDistance = 40
		gui.Parent = host
		local t = Instance.new("TextLabel")
		t.Name = "Text"
		t.Size = UDim2.fromScale(1, 1)
		t.BackgroundTransparency = 0.2
		t.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
		t.TextColor3 = Color3.fromRGB(255, 220, 120)
		t.TextScaled = true
		t.Font = Enum.Font.GothamBold
		t.Parent = gui
	end
	local text = gui:FindFirstChild("Text")
	if text ~= nil then
		text.Text = tostring(have) .. "/" .. tostring(need)
	end
end

local function clearScrewLabel(model)
	local host = hostOf(model)
	local gui = host and host:FindFirstChild("ScrewLabel")
	if gui ~= nil then
		gui:Destroy()
	end
end

local function placeInstalled(session, componentId, instanceId, slotId, socket)
	local model = session.parts[instanceId]
	model:PivotTo(socket.CFrame)
	setAnchored(model, true)
	model:SetAttribute("SlotId", slotId)
	model:SetAttribute("Installed", true)
	AssemblyRules.applyInstall(session.state, componentId, instanceId, slotId)
end

local function setBootState(s, state)
	s.workshop:SetAttribute("BootState", state)
	if s.led ~= nil then
		s.led.Color = BOOT_COLORS[state] or BOOT_COLORS.idle
	end
end

-- Layout context for Decisions.free, in workshop coordinates: table top, case interior, and every other part.
local function layoutFor(s, instanceId, pose)
	local size = s.sizes[instanceId]
	if size == nil then
		return nil
	end
	local model = s.parts[instanceId]
	local centre = PlacementRules.point(s.origin:PointToObjectSpace(pose.Position))
	local others = {}
	for otherId, otherModel in pairs(s.parts) do
		if otherId ~= instanceId and s.sizes[otherId] ~= nil then
			table.insert(others, {
				id = otherId,
				componentId = otherModel:GetAttribute("ComponentId"),
				center = PlacementRules.point(s.origin:PointToObjectSpace(otherModel:GetPivot().Position)),
				size = s.sizes[otherId],
			})
		end
	end
	local candidate = { id = instanceId, componentId = model:GetAttribute("ComponentId"), center = centre, size = size }
	return { candidate = candidate, others = others, caseBox = CASE_BOX, surfaceY = TABLE_TOP, tableBox = TABLE_BOX }
end

-- Loose parts (not installed), as planner input: centre in workshop coordinates, with sizes.
local function looseParts(s)
	local list = {}
	for id, model in pairs(s.parts) do
		if s.state.instances[id] == nil and s.sizes[id] ~= nil then
			table.insert(list, {
				id = id,
				componentId = model:GetAttribute("ComponentId"),
				center = PlacementRules.point(s.origin:PointToObjectSpace(model:GetPivot().Position)),
				size = s.sizes[id],
			})
		end
	end
	return list
end

-- Creates one part on the bench at the first free spot. Returns the instance id, or nil and a code.
local function spawnComponent(s, componentId, starter)
	local entry = WorkshopLayout.Components[componentId]
	if entry == nil then
		return nil, "UNKNOWN_COMPONENT"
	end
	local size = { entry.size[1], entry.size[2], entry.size[3] }
	local x, z = BinPlanner.findSpot(size, looseParts(s), CASE_BOX, TABLE_BOX, TABLE_TOP, WorkshopLayout.BinGrid)
	if x == nil then
		return nil, "BENCH_FULL"
	end
	s.nextIndex = s.nextIndex + 1
	local instanceId = componentId .. "#" .. s.nextIndex
	local model = WorkshopBuilder.buildComponent(componentId)
	model.Name = componentId
	model:SetAttribute("ComponentId", componentId)
	model:SetAttribute("InstanceId", instanceId)
	model:SetAttribute("Installed", false)
	model:SetAttribute("Starter", starter == true)
	model:SetAttribute("Owner", s.player.UserId)
	local home = s.origin * CFrame.new(x, TABLE_TOP + size[2] / 2, z)
	model:PivotTo(home)
	setAnchored(model, true)
	model.Parent = s.workshop
	s.parts[instanceId] = model
	s.homeCFrame[instanceId] = home
	s.sizes[instanceId] = size
	s.starter[instanceId] = starter == true
	return instanceId, nil
end

local function removePart(s, instanceId)
	local model = s.parts[instanceId]
	if model ~= nil then
		model:Destroy()
	end
	s.parts[instanceId] = nil
	s.homeCFrame[instanceId] = nil
	s.sizes[instanceId] = nil
	s.starter[instanceId] = nil
	SessionHold.release(s.hold, instanceId)
end

-- Everything the client shows is published here as workshop attributes. The server is the only writer.
local function publish(s)
	local w = s.workshop
	w:SetAttribute("Wallet", s.ledger.balance)
	w:SetAttribute("Income", s.ledger.earned)
	w:SetAttribute("Expenses", s.ledger.spent)
	w:SetAttribute("XP", s.xp)
	w:SetAttribute("Level", Progression.levelFor(s.xp))
	w:SetAttribute("Mistakes", s.mistakes)
	w:SetAttribute("ActiveOrder", s.activeOrder or "")
	w:SetAttribute("OrderId", s.activeOrder)
	w:SetAttribute("OrderDone", false)
	w:SetAttribute("OrderReady", s.orderReady)
	for id in pairs(Catalog.Orders) do
		w:SetAttribute("Done_" .. id, s.completed[id] == true)
	end
end

local function placeCharacter(player)
	local s = sessions[player]
	local character = player.Character
	if s == nil or character == nil then
		return
	end
	local stand = WorkshopLayout.StandPoint
	local focus = WorkshopLayout.BenchFocus
	local standWorld = s.origin * CFrame.new(stand[1], stand[2], stand[3])
	local focusWorld = s.origin * CFrame.new(focus[1], focus[2], focus[3])
	character:PivotTo(CFrame.new(standWorld.Position, focusWorld.Position))
end

local function createSession(player)
	if remoteFolder == nil or sessions[player] ~= nil then
		return
	end
	workshopCount = workshopCount + 1
	local workshop, led = WorkshopBuilder.buildWorkshop()
	workshop.Name = tostring(player.UserId)
	workshop:PivotTo(CFrame.new(workshopCount * Config.WorkshopSpacing, 0, 0))
	workshop:SetAttribute("Owner", player.UserId)
	workshop:SetAttribute("CaseId", Catalog.StarterPC.caseId)
	workshop:SetAttribute("BootState", "idle")
	workshop.Parent = workshopsFolder

	local origin = workshop:GetPivot()
	local s = {
		player = player,
		workshop = workshop,
		origin = origin,
		benchOrigin = PlacementRules.point(origin.Position),
		caseBox = CASE_BOX,
		led = led,
		state = AssemblyRules.newState(Catalog.StarterPC.caseId),
		parts = {},
		homeCFrame = {},
		sizes = {},
		starter = {},
		hold = SessionHold.new(),
		limiter = RateLimit.new(Config.RateLimit),
		ledger = Ledger.new(Config.StartingCash),
		nextIndex = 0,
		mistakes = 0,
		activeOrder = nil,
		orderReady = false,
		completed = {},
		xp = 0,
	}
	sessions[player] = s

	-- The starter kit and its wrong extras are free, and each one gets the first free spot on the bench.
	local starterList = {}
	for _, id in ipairs(Catalog.StarterPC.kit) do table.insert(starterList, id) end
	for _, id in ipairs(Catalog.StarterPC.extras) do table.insert(starterList, id) end
	for _, componentId in ipairs(starterList) do
		local _, code = spawnComponent(s, componentId, true)
		if code ~= nil then
			warn("[AssemblyServer] Could not place starter part " .. componentId .. ": " .. code)
		end
	end
	publish(s)
	placeCharacter(player)
	notify(player, "system", true, "WORKSHOP_READY", {})
end

-- ---------- request handlers: every one validates its arguments first ----------

local function onPickUp(player, instanceId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "PickUp", os.clock(), RequestGuard.isId(instanceId))
	if admitCode == "REQUEST_INVALID" then return notifyInvalid(player, "pickup", instanceId) end
	if admitCode == "RATE_LIMITED" then return notify(player, "pickup", false, "RATE_LIMITED", {}, { instanceId = instanceId }) end
	local model = s.parts[instanceId]
	if model == nil or model:GetAttribute("Owner") ~= player.UserId then
		return notify(player, "pickup", false, "NOT_IN_WORKSHOP", {}, { instanceId = instanceId })
	end
	if s.state.instances[instanceId] ~= nil then
		return notify(player, "pickup", false, "LOCKED_INSTALLED", {}, { instanceId = instanceId })
	end
	local root = rootPoint(player)
	if root == nil or not PlacementRules.inReach(root, PlacementRules.point(model:GetPivot().Position), Config.MaxInteractDistance) then
		return notify(player, "pickup", false, "TOO_FAR", {}, { instanceId = instanceId })
	end
	SessionHold.pick(s.hold, instanceId)
	return notify(player, "pickup", true, "PICKED_UP", {}, { instanceId = instanceId })
end

local function onReleaseHold(player, instanceId)
	local s = sessions[player]
	if s == nil then return end
	if not RequestGuard.isId(instanceId) then return end
	s.limiter:allow("ReleaseHold", os.clock()) -- counted only: a release always takes effect
	SessionHold.release(s.hold, instanceId)
end

-- A refused install or drop. Wrong-part refusals count as mistakes for the grade.
local function refusePlacement(s, player, instanceId, code, params)
	if MISTAKE_CODES[code] then
		s.mistakes = s.mistakes + 1
		publish(s)
	end
	return notify(player, "placement", false, code, params or {}, { instanceId = instanceId })
end

-- Any change to the build clears the ready flag, so a stale "ready" can never be delivered.
local function buildChanged(s)
	s.orderReady = false
	publish(s)
end

-- The client proposes a pose. An empty slotId means free placement on the bench.
local function onProposePlacement(player, instanceId, pose, slotId)
	local s = sessions[player]
	if s == nil then return end
	local validArgs = RequestGuard.isId(instanceId)
		and RequestGuard.isSlotOrFree(slotId, Catalog)
		and typeof(pose) == "CFrame"
		and RequestGuard.isFinitePose({ pos = pose.Position, look = pose.LookVector, up = pose.UpVector })
	-- Every proposal ends the hold attempt, whatever the outcome. Only a well-formed id can own a hold.
	local wasHeld = RequestGuard.isId(instanceId) and SessionHold.consume(s.hold, instanceId) or false
	local admitCode = RequestGuard.admit(s.limiter, "ProposePlacement", os.clock(), validArgs)
	if admitCode == "REQUEST_INVALID" then return notifyInvalid(player, "placement", instanceId) end
	if admitCode == "RATE_LIMITED" then return notify(player, "placement", false, "RATE_LIMITED", {}, { instanceId = instanceId }) end
	if not wasHeld then return notify(player, "placement", false, "NOT_HELD", {}, { instanceId = instanceId }) end
	local model = s.parts[instanceId]
	if model == nil or model:GetAttribute("Owner") ~= player.UserId then
		return notify(player, "placement", false, "NOT_IN_WORKSHOP", {}, { instanceId = instanceId })
	end
	local root = rootPoint(player)
	if root == nil then return notify(player, "placement", false, "TOO_FAR", {}, { instanceId = instanceId }) end
	local componentId = model:GetAttribute("ComponentId")
	local proposed = poseOf(pose)

	-- Free placement on the bench. The shared decision checks reach, bounds, height, table top, case and other parts.
	if slotId == "" then
		local okFree, codeFree, paramsFree = Decisions.free({
			player = root,
			proposed = proposed,
			benchOrigin = s.benchOrigin,
			benchHalf = BENCH_HALF,
			maxReach = Config.MaxInteractDistance,
			layout = layoutFor(s, instanceId, pose),
		})
		if not okFree then
			return refusePlacement(s, player, instanceId, codeFree, paramsFree)
		end
		model:PivotTo(pose)
		setAnchored(model, true)
		return notify(player, "placement", true, "PLACED_FREE", { part = componentId }, { instanceId = instanceId, final = pose })
	end

	-- Install into a socket. The same shared decision the client preview uses: rules, bounds, socket, reach, alignment.
	local socket = findSocket(s, slotId)
	local okInstall, codeInstall, paramsInstall = Decisions.install({
		state = s.state,
		catalog = Catalog,
		componentId = componentId,
		instanceId = instanceId,
		slotId = slotId,
		proposed = proposed,
		socket = socket and poseOf(socket.CFrame) or nil,
		player = root,
		benchOrigin = s.benchOrigin,
		benchHalf = BENCH_HALF,
		maxReach = Config.MaxInteractDistance,
		cfg = INSTALL_CFG,
	})
	if not okInstall then
		return refusePlacement(s, player, instanceId, codeInstall, paramsInstall)
	end
	placeInstalled(s, componentId, instanceId, slotId, socket)
	setScrewLabel(model, 0, Catalog.Components[componentId].screwsRequired or 0)
	buildChanged(s)
	return notify(player, "placement", true, "INSTALLED", { part = componentId, slot = slotId }, { instanceId = instanceId, final = socket.CFrame })
end

-- Removing a part sends it back to the first free spot on the bench, so it never lands on another part.
local function onRequestUninstall(player, instanceId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "RequestUninstall", os.clock(), RequestGuard.isId(instanceId))
	if admitCode == "REQUEST_INVALID" then return notifyInvalid(player, "uninstall", instanceId) end
	if admitCode == "RATE_LIMITED" then return notify(player, "uninstall", false, "RATE_LIMITED", {}) end
	local model = s.parts[instanceId]
	if model == nil or model:GetAttribute("Owner") ~= player.UserId then
		return notify(player, "uninstall", false, "NOT_IN_WORKSHOP", {}, { instanceId = instanceId })
	end
	local root = rootPoint(player)
	if root == nil or not PlacementRules.inReach(root, PlacementRules.point(model:GetPivot().Position), Config.MaxInteractDistance) then
		return notify(player, "uninstall", false, "TOO_FAR", {}, { instanceId = instanceId })
	end
	local ok, diag = AssemblyRules.validateUninstall(s.state, Catalog, instanceId)
	if not ok then
		return notify(player, "uninstall", false, diag.code, diag.params, { instanceId = instanceId })
	end
	local size = s.sizes[instanceId]
	local x, z = BinPlanner.findSpot(size, looseParts(s), CASE_BOX, TABLE_BOX, TABLE_TOP, WorkshopLayout.BinGrid)
	if x == nil then
		return notify(player, "uninstall", false, "BENCH_FULL", {}, { instanceId = instanceId })
	end
	local componentId = model:GetAttribute("ComponentId")
	AssemblyRules.applyUninstall(s.state, instanceId)
	local home = s.origin * CFrame.new(x, TABLE_TOP + size[2] / 2, z)
	s.homeCFrame[instanceId] = home
	model:PivotTo(home)
	model:SetAttribute("SlotId", nil)
	model:SetAttribute("Installed", false)
	clearScrewLabel(model)
	buildChanged(s)
	return notify(player, "uninstall", true, "REMOVED", { part = componentId }, { instanceId = instanceId })
end

local function onTightenScrew(player, instanceId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "TightenScrew", os.clock(), RequestGuard.isId(instanceId))
	if admitCode == "REQUEST_INVALID" then return notifyInvalid(player, "screw", instanceId) end
	if admitCode == "RATE_LIMITED" then return notify(player, "screw", false, "RATE_LIMITED", {}) end
	local model = s.parts[instanceId]
	if model == nil or model:GetAttribute("Owner") ~= player.UserId then
		return notify(player, "screw", false, "NOT_IN_WORKSHOP", {}, { instanceId = instanceId })
	end
	local root = rootPoint(player)
	if root == nil or not PlacementRules.inReach(root, PlacementRules.point(model:GetPivot().Position), Config.MaxInteractDistance) then
		return notify(player, "screw", false, "TOO_FAR", {}, { instanceId = instanceId })
	end
	local ok, diag = AssemblyRules.validateTighten(s.state, Catalog, instanceId)
	if not ok then
		return notify(player, "screw", false, diag.code, diag.params, { instanceId = instanceId })
	end
	AssemblyRules.applyTighten(s.state, instanceId)
	local inst = s.state.instances[instanceId]
	local need = Catalog.Components[inst.componentId].screwsRequired or 0
	local have = s.state.screws[instanceId]
	setScrewLabel(model, have, need)
	buildChanged(s)
	return notify(player, "screw", true, "SCREW_ADDED", { part = inst.componentId, have = have, need = need }, { instanceId = instanceId })
end

-- Boot test. The PC boots, then the order check runs. Paying happens only at delivery.
local function onRequestBoot(player)
	local s = sessions[player]
	if s == nil then return end
	if not s.limiter:allow("RequestBoot", os.clock()) then
		return notify(player, "boot", false, "RATE_LIMITED", {})
	end
	local boot = AssemblyRules.evaluateBoot(s.state, Catalog)
	if not boot.ok then
		setBootState(s, "fail")
		s.orderReady = false
		publish(s)
		return notify(player, "boot", false, "BOOT_FAILED", {}, { diagnostics = boot.diagnostics })
	end
	setBootState(s, "ok")
	if s.activeOrder == nil then
		s.orderReady = false
		publish(s)
		return notify(player, "boot", true, "BOOT_OK_NO_ORDER", {})
	end
	local met, diagnostics = Orders.check(s.state, Catalog, Catalog.Orders[s.activeOrder])
	s.orderReady = met
	publish(s)
	if not met then
		return notify(player, "boot", false, "ORDER_NOT_MET", {}, { diagnostics = diagnostics })
	end
	return notify(player, "boot", true, "ORDER_READY", { order = s.activeOrder })
end

local function onBuyPart(player, componentId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "BuyPart", os.clock(), RequestGuard.isComponentId(componentId, Catalog))
	if admitCode ~= nil then
		return notify(player, "shop", false, admitCode, {})
	end
	local comp = Catalog.Components[componentId]
	local canBuy, codeBuy = Store.canBuy(s.ledger.balance, Progression.levelFor(s.xp), comp)
	if not canBuy then
		return notify(player, "shop", false, codeBuy, { part = componentId })
	end
	local instanceId, codeSpawn = spawnComponent(s, componentId, false)
	if instanceId == nil then
		return notify(player, "shop", false, codeSpawn, {})
	end
	local spent = Ledger.spend(s.ledger, comp.price)
	if not spent then
		removePart(s, instanceId)
		return notify(player, "shop", false, "NOT_ENOUGH_CASH", { part = componentId })
	end
	publish(s)
	return notify(player, "shop", true, "PURCHASED", { part = componentId, price = comp.price }, { instanceId = instanceId })
end

local function onSellPart(player, instanceId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "SellPart", os.clock(), RequestGuard.isId(instanceId))
	if admitCode ~= nil then
		return notify(player, "shop", false, admitCode, {})
	end
	local model = s.parts[instanceId]
	if model == nil or model:GetAttribute("Owner") ~= player.UserId then
		return notify(player, "shop", false, "NOT_IN_WORKSHOP", {}, { instanceId = instanceId })
	end
	if s.state.instances[instanceId] ~= nil then
		return notify(player, "shop", false, "LOCKED_INSTALLED", {}, { instanceId = instanceId })
	end
	if s.starter[instanceId] then
		return notify(player, "shop", false, "STARTER_PART", {}, { instanceId = instanceId })
	end
	local componentId = model:GetAttribute("ComponentId")
	local refund = Store.sellValue(Catalog.Components[componentId].price, Config.SellRatioPercent)
	removePart(s, instanceId)
	Ledger.receive(s.ledger, refund)
	publish(s)
	return notify(player, "shop", true, "SOLD", { part = componentId, amount = refund }, { instanceId = instanceId })
end

local function onAcceptOrder(player, orderId)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "AcceptOrder", os.clock(), RequestGuard.isId(orderId))
	if admitCode ~= nil then
		return notify(player, "order", false, admitCode, {})
	end
	local order = Catalog.Orders[orderId]
	if order == nil then
		return notify(player, "order", false, "UNKNOWN_ORDER", {})
	end
	if s.completed[orderId] then
		return notify(player, "order", false, "ORDER_ALREADY_COMPLETED", { order = orderId })
	end
	if s.activeOrder ~= nil then
		return notify(player, "order", false, "ORDER_ALREADY_ACTIVE", { order = s.activeOrder })
	end
	if not Progression.isUnlocked(Progression.levelFor(s.xp), order.minLevel) then
		return notify(player, "order", false, "ORDER_LOCKED", { order = orderId, level = order.minLevel })
	end
	s.activeOrder = orderId
	s.orderReady = false
	publish(s)
	return notify(player, "order", true, "ORDER_ACCEPTED", { order = orderId })
end

-- Delivery re-checks everything on the server, pays once, and consumes the parts the PC was built from.
local function onDeliverOrder(player)
	local s = sessions[player]
	if s == nil then return end
	local admitCode = RequestGuard.admit(s.limiter, "DeliverOrder", os.clock(), true)
	if admitCode ~= nil then
		return notify(player, "order", false, admitCode, {})
	end
	if s.activeOrder == nil then
		return notify(player, "order", false, "NO_ACTIVE_ORDER", {})
	end
	local order = Catalog.Orders[s.activeOrder]
	local boot = AssemblyRules.evaluateBoot(s.state, Catalog)
	if not boot.ok then
		s.orderReady = false
		publish(s)
		return notify(player, "order", false, "BOOT_FAILED", {}, { diagnostics = boot.diagnostics })
	end
	local met, diagnostics = Orders.check(s.state, Catalog, order)
	if not met then
		s.orderReady = false
		publish(s)
		return notify(player, "order", false, "ORDER_NOT_MET", { order = order.id }, { diagnostics = diagnostics })
	end
	local reward = Orders.reward(order, s.mistakes)
	local paid = Ledger.complete(s.ledger, order.id, reward.money)
	if not paid then
		return notify(player, "order", false, "ORDER_ALREADY_COMPLETED", { order = order.id })
	end
	for instanceId in pairs(s.state.instances) do
		removePart(s, instanceId)
	end
	s.state = AssemblyRules.newState(Catalog.StarterPC.caseId)
	s.hold = SessionHold.new()
	s.completed[order.id] = true
	s.xp = s.xp + reward.xp
	s.activeOrder = nil
	s.orderReady = false
	s.mistakes = 0
	setBootState(s, "idle")
	publish(s)
	return notify(player, "order", true, "ORDER_DELIVERED", {
		order = order.id, grade = reward.grade, payout = reward.money, xp = reward.xp, wallet = s.ledger.balance,
	})
end

-- ---------- players ----------

local function onPlayerAdded(player)
	-- Connect FIRST. If CharacterAdded fires while the workshop is being built,
	-- the callback waits for the session instead of losing the initial spawn.
	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root == nil then
				return
			end
			-- Session creation may still be in progress. Wait up to five seconds.
			for _ = 1, 50 do
				if sessions[player] ~= nil then
					break
				end
				if player.Parent == nil then
					return
				end
				task.wait(0.1)
			end
			if sessions[player] ~= nil and player.Character == character then
				placeCharacter(player)
			end
		end)
	end)

	createSession(player)

	-- Also handle a character that already exists before PlayerAdded is processed.
	local character = player.Character
	if character ~= nil then
		task.spawn(function()
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root ~= nil and player.Character == character then
				placeCharacter(player)
			end
		end)
	end
end

local function onPlayerRemoving(player)
	local s = sessions[player]
	sessions[player] = nil
	if s ~= nil and s.workshop ~= nil then
		s.workshop:Destroy()
	end
end

if remoteFolder ~= nil then
	remoteFolder.PickUp.OnServerEvent:Connect(onPickUp)
	remoteFolder.ReleaseHold.OnServerEvent:Connect(onReleaseHold)
	remoteFolder.ProposePlacement.OnServerEvent:Connect(onProposePlacement)
	remoteFolder.RequestUninstall.OnServerEvent:Connect(onRequestUninstall)
	remoteFolder.TightenScrew.OnServerEvent:Connect(onTightenScrew)
	remoteFolder.RequestBoot.OnServerEvent:Connect(onRequestBoot)
	remoteFolder.BuyPart.OnServerEvent:Connect(onBuyPart)
	remoteFolder.SellPart.OnServerEvent:Connect(onSellPart)
	remoteFolder.AcceptOrder.OnServerEvent:Connect(onAcceptOrder)
	remoteFolder.DeliverOrder.OnServerEvent:Connect(onDeliverOrder)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
end
</ProtectedString>
