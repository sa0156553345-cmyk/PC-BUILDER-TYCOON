          <string name="Name">Ledger</string>
          <ProtectedString name="Source">-- Ledger.lua
-- Place in: ReplicatedStorage &gt; Shared (ModuleScript "Ledger")
-- PURE money book. Balance, income and expenses change only through these functions, and only with whole positive amounts.
-- An order pays once: complete() refuses repeats. In V0.2 this lives in server memory only (no DataStore yet).

local Ledger = {}

local function wholePositive(n)
	return type(n) == "number" and n == n and n &gt; 0 and n &lt;= 1000000 and n == math.floor(n)
end

function Ledger.new(startBalance)
	return { balance = startBalance or 0, completed = {}, spent = 0, earned = 0 }
end

-- Returns true, "PAID" on the first valid completion.
-- Returns false, "ALREADY_PAID" for a repeat, and false, "INVALID" for a bad order id or payout.
function Ledger.complete(l, orderId, payout)
	if type(orderId) ~= "string" or orderId == "" or not wholePositive(payout) then
		return false, "INVALID"
	end
	if l.completed[orderId] then
		return false, "ALREADY_PAID"
	end
	l.completed[orderId] = true
	l.balance = l.balance + payout
	l.earned = l.earned + payout
	return true, "PAID"
end

-- Pays for a part. Returns true, "SPENT", or false with "INVALID" or "NOT_ENOUGH_CASH".
function Ledger.spend(l, amount)
	if not wholePositive(amount) then
		return false, "INVALID"
	end
	if amount &gt; l.balance then
		return false, "NOT_ENOUGH_CASH"
	end
	l.balance = l.balance - amount
	l.spent = l.spent + amount
	return true, "SPENT"
end

-- Money from a sale. Returns true, "RECEIVED", or false, "INVALID".
function Ledger.receive(l, amount)
	if not wholePositive(amount) then
		return false, "INVALID"
	end
	l.balance = l.balance + amount
	l.earned = l.earned + amount
	return true, "RECEIVED"
end

function Ledger.isComplete(l, orderId)
	return l.completed[orderId] == true
end

function Ledger.balanceOf(l)
	return l.balance
end

return Ledger
