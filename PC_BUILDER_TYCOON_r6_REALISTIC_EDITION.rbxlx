      <Item class="ModuleScript" referent="RBX496D074B0044B6B81C6C75715916DCA2">
        <Properties>
          <string name="Name">test_economy</string>
          <ProtectedString name="Source">-- Tests: Ledger, Store and BinPlanner (pure).
return function(T, load)
	local Ledger = load("Ledger")
	local Store = load("Store")
	local Catalog = load("Catalog")
	local BinPlanner = load("BinPlanner")
	local Layout = load("WorkshopLayout")
	local PlacementRules = load("PlacementRules")

	-- Ledger: money only moves through these functions, and never below zero.
	local l = Ledger.new(200)
	T.eq("starting cash", l.balance, 200)
	local ok, code = Ledger.spend(l, 50)
	T.check("spend within cash succeeds", ok and code == "SPENT")
	T.eq("balance after spend", l.balance, 150)
	T.eq("spent total", l.spent, 50)
	T.eq("overdraw refused", select(2, Ledger.spend(l, 999)), "NOT_ENOUGH_CASH")
	T.eq("balance unchanged after refused spend", l.balance, 150)
	T.eq("zero spend refused", select(2, Ledger.spend(l, 0)), "INVALID")
	T.eq("fractional spend refused", select(2, Ledger.spend(l, 1.5)), "INVALID")
	T.eq("NaN spend refused", select(2, Ledger.spend(l, 0 / 0)), "INVALID")
	T.eq("first delivery paid", select(2, Ledger.complete(l, "office_01", 250)), "PAID")
	T.eq("balance after payment", l.balance, 400)
	T.eq("second payment for the same order refused", select(2, Ledger.complete(l, "office_01", 250)), "ALREADY_PAID")
	T.eq("income counts only the payment", l.earned, 250)
	Ledger.receive(l, 15)
	T.eq("sale adds cash", l.balance, 415)
	T.eq("sale counts as income", l.earned, 265)

	-- Store: locked products, cash, and sell-back value.
	local gpu = Catalog.Components.gpu_rtx_3060
	T.eq("locked product refused at level 1", select(2, Store.canBuy(1000, 1, gpu)), "PRODUCT_LOCKED")
	T.eq("unaffordable product refused", select(2, Store.canBuy(10, 2, gpu)), "NOT_ENOUGH_CASH")
	T.check("unlocked and affordable product allowed", Store.canBuy(100, 2, gpu))
	T.eq("the case is not for sale", select(2, Store.canBuy(999, 9, Catalog.Components.case_corsair_4000d)), "UNKNOWN_COMPONENT")
	T.eq("sell value is half, rounded down (90)", Store.sellValue(90, 50), 45)
	T.eq("sell value is half, rounded down (15)", Store.sellValue(15, 50), 7)

	local list = Store.listFor(Catalog, 1)
	local sorted, hasCase, gpuItem = true, false, nil
	for i, item in ipairs(list) do
		if i &gt; 1 and list[i - 1].price &gt; item.price then sorted = false end
		if item.kind == "Case" then hasCase = true end
		if item.id == "gpu_rtx_3060" then gpuItem = item end
	end
	T.check("shop list is sorted by price", sorted)
	T.check("the case is not in the shop", not hasCase)
	T.check("the GPU is listed but locked at level 1", gpuItem ~= nil and gpuItem.unlocked == false)

	-- BinPlanner: spots never overlap the case, the table edge or another part.
	local caseBox = { center = PlacementRules.fromArray(Layout.Case.center), size = Layout.Case.size }
	local tableBox = { center = PlacementRules.fromArray(Layout.Table.center), size = Layout.Table.size }
	local placed, count = {}, 0
	for i = 1, 40 do
		local id = (i % 2 == 0) and "ssd_samsung_980_500" or "cable_rm550_mb24"
		local entry = Layout.Components[id]
		local size = { entry.size[1], entry.size[2], entry.size[3] }
		local x, z = BinPlanner.findSpot(size, placed, caseBox, tableBox, Layout.TableTopY, Layout.BinGrid)
		if x == nil then break end
		table.insert(placed, {
			id = "p" .. i, componentId = id,
			center = { x = x, y = Layout.TableTopY + size[2] / 2, z = z }, size = size,
		})
		count = count + 1
	end
	T.check("the bench takes at least 20 small parts", count &gt;= 20, count)
	local clean = true
	for i = 1, #placed do
		for j = i + 1, #placed do
			if PlacementRules.boxesOverlap(placed[i].center, placed[i].size, placed[j].center, placed[j].size, 0.05) then
				clean = false
			end
		end
	end
	T.check("planned parts never overlap each other", clean)
	local mx, mz = BinPlanner.findSpot({ 10, 10, 0.4 }, {}, caseBox, tableBox, Layout.TableTopY, Layout.BinGrid)
	T.check("an empty bench has room for a motherboard", mx ~= nil)
	T.check("the motherboard spot stays on the table", mx ~= nil and math.abs(mx) + 5 &lt;= 22 and mz ~= nil)
end
</ProtectedString>
