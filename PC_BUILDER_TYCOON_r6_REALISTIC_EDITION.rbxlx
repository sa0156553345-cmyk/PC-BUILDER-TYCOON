    <Item class="Script" referent="RBXC71E125F796723E60E7C03EF4A80EF9E">
      <Properties>
        <string name="Name">TestRunner</string>
        <bool name="Disabled">true</bool>
        <ProtectedString name="Source">-- TestRunner.lua
-- Place in: ServerScriptService (Script named "TestRunner"). Saved DISABLED.
-- Enable it in Studio to run the pure test suite (ServerStorage &gt; Tests). Results print in the Output window.
-- The same test files are run outside Roblox by tests/run_all.lua.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tests = ServerStorage:WaitForChild("Tests")

local T = { passed = 0, failed = 0 }
function T.check(name, cond, detail)
	if cond then
		T.passed = T.passed + 1
	else
		T.failed = T.failed + 1
		warn("[TestRunner] FAIL: " .. name .. (detail ~= nil and (" [" .. tostring(detail) .. "]") or ""))
	end
end
function T.eq(name, actual, expected)
	T.check(name, actual == expected, "expected " .. tostring(expected) .. ", got " .. tostring(actual))
end

local function load(name)
	return require(Shared:WaitForChild(name))
end

for _, name in ipairs({ "test_progression", "test_economy", "test_orders", "test_rules", "test_catalog" }) do
	require(Tests:WaitForChild(name))(T, load)
end
print(string.format("[TestRunner] PASSED %d   FAILED %d", T.passed, T.failed))
</ProtectedString>
